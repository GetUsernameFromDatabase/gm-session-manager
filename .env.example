# Copy to .env and fill in. The server refuses to start without both admin values.
# Admin login is for GM devices other than the host PC; localhost is always admin.
# Change these before other devices join.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional. Defaults shown.
PORT=8080
# A relative DATA_DIR is read from the project folder (on a server install, the checkout).
DATA_DIR=data

# Server install only (deploy/README.md), optional: the account the container runs as, which must own DATA_DIR.
# Left out, it is 65532, the image's own non-root user.
# GSM_UID=65532
# GSM_GID=65532
