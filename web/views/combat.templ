package views

import (
	"fmt"
	"slices"
	"strconv"
	"strings"

	"gm-session-manager/db/sqlc"
	"gm-session-manager/dnd5e"
	"gm-session-manager/web/components/alert"
	"gm-session-manager/web/components/badge"
	"gm-session-manager/web/components/button"
	"gm-session-manager/web/components/dialog"
	"gm-session-manager/web/components/field"
	"gm-session-manager/web/components/icon"
	"gm-session-manager/web/components/input"
	"gm-session-manager/web/components/inputgroup"
	"gm-session-manager/web/components/popover"
	selectcomp "gm-session-manager/web/components/select"
	switchcomp "gm-session-manager/web/components/switch"
	"gm-session-manager/web/components/tabs"
	"gm-session-manager/web/components/tooltip"
	"gm-session-manager/web/utils"
)

// MaxHPInput bounds the HP dialog's numbers, well above any 5e creature.
const MaxHPInput = 9999

// MaxMarker bounds a combatant's table marker, in characters.
const MaxMarker = 40

// chipConditions is how many conditions a player's chip shows before "+N".
const chipConditions = 2

// CombatantView is one row of the turn order as a viewer sees it.
type CombatantView struct {
	ID          int64
	Name        string
	Initiative  string
	AC          int64
	HP          int64
	MaxHP       int64
	TempHP      int64
	ShowHP      bool
	HPVisible   bool
	CharacterID int64
	EntityID    int64
	// Kind is the type of being: KindPC, KindNPC or KindMonster.
	Kind       string
	IsOwn      bool
	Active     bool
	Conditions []sqlc.Condition
	// Out is a combatant out of the fight, whose turn is skipped.
	Out bool
	// Down is at 0 HP, shown to everyone even when the HP is hidden.
	Down bool
	// InitMod is the initiative roll's bonus, GM only.
	InitMod int
	// Link is the combatant's source page, when the viewer may open it.
	Link string
	// Portrait is a character's or NPC's current look, when the viewer may see
	// it, else the compendium monster's picture.
	Portrait string
	// Marker names its piece on the physical table, GM only.
	Marker string
}

// EncounterView is the tracker for one encounter.
type EncounterView struct {
	Encounter  sqlc.Encounter
	Combatants []CombatantView
	IsGM       bool
	// Add-combatant choices, GM only.
	Characters []sqlc.Character
	Entities   []sqlc.Entity
}

// Combatant kinds, the type of being shown on each row.
const (
	KindPC      = "pc"
	KindNPC     = "npc"
	KindMonster = "monster"
)

// kindLabel and kindTint set the kinds apart, as visibility does note blocks.
var (
	kindLabel  = map[string]string{KindPC: "PC", KindNPC: "NPC", KindMonster: "Monster"}
	kindTint   = map[string]string{KindPC: "border-l-sky-400/60", KindNPC: "border-l-amber-400/60", KindMonster: "border-l-rose-400/60"}
	kindGroup  = map[string]string{KindPC: "PCs", KindNPC: "NPCs", KindMonster: "Monsters"}
	kindBorder = map[string]string{KindPC: "border-sky-400/60", KindNPC: "border-amber-400/60", KindMonster: "border-rose-400/60"}
	kindDot    = map[string]string{KindPC: "bg-sky-400/60", KindNPC: "bg-amber-400/60", KindMonster: "bg-rose-400/60"}
)

// CombatView is the combat page.
type CombatView struct {
	CampaignID int64
	IsGM       bool
	Encounters []sqlc.Encounter
	Current    *EncounterView
	// Want is the encounter a player asked for; 0 follows the live fight.
	Want int64
}

templ CombatPage(l Layout, v CombatView) {
	@Page(l) {
		// The navbar already says where we are; the list needs the room.
		<h1 class="sr-only">Combat</h1>
		if v.IsGM {
			@EncounterList(v.CampaignID, v.Encounters, currentID(v))
		}
		if v.IsGM {
			if v.Current != nil {
				@Encounter(*v.Current)
			}
		} else {
			@PlayerCombat(v.CampaignID, v.Want, v.Encounters, v.Current)
		}
	}
}

// PlayerCombat is a player's whole combat area: the started fights their
// character is in. It is replaced as one piece whenever any encounter
// changes, so starting or ending a fight shows up without knowing the
// encounter id in advance.
templ PlayerCombat(campaignID, want int64, encounters []sqlc.Encounter, e *EncounterView) {
	<div id="player-combat" hx-swap-oob="true" { live(LivePlayerCombat, campaignID, want)... }>
		if e == nil {
			<p class="text-muted-foreground">No fights yet. This page updates when the GM starts one you're in.</p>
		} else {
			if len(encounters) > 1 {
				<div class="mb-6 flex flex-wrap items-center gap-2">
					@encounterLinks(campaignID, encounters, e.Encounter.ID)
				</div>
			}
			@Encounter(*e)
		}
	</div>
}

func currentID(v CombatView) int64 {
	if v.Current == nil {
		return 0
	}
	return v.Current.Encounter.ID
}

templ EncounterList(campaignID int64, encounters []sqlc.Encounter, current int64) {
	<div id="encounter-list" hx-swap-oob="true" class="mb-6 flex flex-wrap items-center gap-2" { live(LiveEncounters, campaignID, current)... }>
		@encounterLinks(campaignID, encounters, current)
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campaigns/%d/encounters", campaignID)) } class="flex gap-2">
			@input.Input(input.Props{Name: "name", Placeholder: "New encounter", Required: true, Class: "h-8"})
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				@icon.Plus()
				Create
			}
		</form>
	</div>
}

templ encounterLinks(campaignID int64, encounters []sqlc.Encounter, current int64) {
	for _, e := range encounters {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/campaigns/%d/combat?encounter=%d", campaignID, e.ID)) }
			class="inline-flex h-8 items-center gap-1 rounded-md border px-3 text-sm aria-[current=page]:border-primary/60 aria-[current=page]:bg-accent aria-[current=page]:font-medium"
			if e.ID == current {
				aria-current="page"
			}
		>
			{ e.Name }
			if e.Status == "active" {
				<span class="text-green-600">●</span>
			} else if e.Status == "ended" {
				<span class="text-muted-foreground">(ended)</span>
			}
		</a>
	}
}

func (e EncounterView) url(action string) string {
	return fmt.Sprintf("/encounters/%d/%s", e.Encounter.ID, action)
}

templ Encounter(e EncounterView) {
	// Players get the tracker inside PlayerCombat's live view.
	<section
		id={ fmt.Sprintf("encounter-%d", e.Encounter.ID) }
		hx-swap-oob="true"
		class="space-y-4"
		if e.IsGM {
			{ live(LiveEncounter, e.Encounter.ID)... }
		}
	>
		if !e.showsTracker() {
			<p class="text-muted-foreground">No fight right now. This page updates when the GM starts one.</p>
		} else {
			<div class="flex flex-wrap items-center justify-between gap-2">
				<h2 class="text-xl font-semibold">
					{ e.Encounter.Name }
					if e.Encounter.Status == "active" {
						<span class="ml-2 text-base font-normal text-muted-foreground" { bind("text=round")... }>{ roundLabel(e.Encounter.Round) }</span>
					}
				</h2>
				if e.IsGM {
					<div class="flex flex-wrap gap-2">
						switch e.Encounter.Status {
							case "preparing":
								@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": e.url("start")}}) {
									Start
								}
							case "active":
								@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": e.url("end")}}) {
									End
								}
							case "ended":
								@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": e.url("start")}}) {
									Restart
								}
						}
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantDestructive, Attributes: templ.Attributes{"hx-post": e.url("delete"), "hx-confirm": "Delete this encounter?", "aria-label": "Delete encounter"}}) {
							@icon.Trash2()
						}
					</div>
				}
			</div>
			// A running fight shows this inside its turn card.
			if e.IsGM && e.Encounter.Status == "preparing" && !e.initiativeSet() {
				@alert.Alert(alert.Props{Class: "*:[svg]:translate-y-0 *:[svg]:self-center border-amber-500/50 bg-amber-500/10 text-amber-800 *:data-[slot=alert-description]:text-amber-800/90 dark:text-amber-300 dark:*:data-[slot=alert-description]:text-amber-300/90"}) {
					@icon.TriangleAlert()
					@alert.Title() {
						Next turn needs everyone's initiative
					}
					@alert.Description() {
						Missing: { strings.Join(e.missingInitiative(), ", ") }
					}
				}
			}
			if e.Encounter.Status == "active" {
				@turnCard(e)
			}
			if e.IsGM {
				<ol id={ fmt.Sprintf("combatants-%d", e.Encounter.ID) } data-keep-scroll class="max-h-[max(14rem,calc(100dvh-26rem))] divide-y overflow-y-auto rounded-lg border">
					for _, c := range e.Combatants {
						@combatantRow(e, c)
					}
					if len(e.Combatants) == 0 {
						<li class="p-3 text-sm text-muted-foreground">No combatants yet.</li>
					}
				</ol>
				@addCombatants(e)
			} else {
				for _, c := range e.Combatants {
					if c.IsOwn {
						@ownCombatant(c)
					}
				}
				for _, g := range e.playerGroups() {
					<section class="space-y-2">
						<h3 class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
							<span class={ "size-2 rounded-full", kindDot[g.Kind] }></span>
							{ g.Label }
						</h3>
						<ul class="flex flex-wrap items-start gap-2">
							for _, c := range g.Cards {
								@combatantChip(c)
							}
						</ul>
					</section>
				}
			}
		}
	</section>
}

// combatantRow is one line of the GM's turn order.
templ combatantRow(e EncounterView, c CombatantView) {
	// One rung of the initiative ladder: amber marks whose turn it is, rose who
	// is down; the controls wrap under the name on narrow screens.
	<li class={ "group/row flex flex-wrap items-center gap-x-3 gap-y-2 border-l-4 py-2 pr-2 pl-1 data-[active=true]:border-l-primary data-[active=true]:bg-primary/10 data-[down=true]:bg-rose-500/10", kindTint[c.Kind], templ.KV("opacity-60", c.Out) } { combatantState(c)... }>
		@initiativeInput(c)
		@portrait(c, "size-8")
		<span class="flex min-w-0 flex-1 flex-wrap items-center gap-1.5">
			@combatantName(c)
			@beingBadge(c)
			@turnBadges(c)
		</span>
		<div class="flex flex-wrap items-center gap-2 max-md:basis-full max-md:pl-[6.75rem]">
			@input.Input(input.Props{Name: "marker", Value: c.Marker, Placeholder: "Marker", Class: "h-7 w-24", Attributes: templ.Attributes{
				"aria-label": "Table marker", "title": "Which piece on the table, e.g. mini 5", "maxlength": fmt.Sprint(MaxMarker),
				"hx-post": fmt.Sprintf("/combatants/%d/marker", c.ID), "hx-trigger": "change",
			}})
			<span class="w-11 text-sm text-muted-foreground tabular-nums">AC { fmt.Sprint(c.AC) }</span>
			<span class="flex items-center gap-1.5">
				@hpDialog(c)
				@hpMeter(c, "w-14")
				@tooltip.Tooltip() {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconXs, Class: "text-muted-foreground", Attributes: with(templ.Attributes{"aria-label": visibleTitle(c.HPVisible), "hx-post": fmt.Sprintf("/combatants/%d/visible", c.ID)}, tooltip.Trigger(ctx))}) {
						if c.HPVisible {
							@icon.Eye()
						} else {
							@icon.EyeOff()
						}
					}
					@tooltip.Content() {
						{ visibleTitle(c.HPVisible) }
					}
				}
			</span>
			@conditionDialog(c)
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconXs, Class: quietDestructive, Attributes: templ.Attributes{"aria-label": "Remove combatant", "hx-post": fmt.Sprintf("/combatants/%d/delete", c.ID)}}) {
				@icon.X()
			}
		</div>
		// Conditions get their own line, so adding one moves no control.
		if len(c.Conditions) > 0 {
			<div class="flex basis-full flex-wrap items-center gap-1 pl-[6.75rem]">
				for _, cond := range c.Conditions {
					@combatCondition(cond, true)
				}
			</div>
		}
	</li>
}

// ownCombatant is the player's own character in the fight: HP to change
// and conditions to end, above everyone else.
templ ownCombatant(c CombatantView) {
	<div class={ "group/row space-y-3 rounded-lg border border-l-4 p-3 data-[active=true]:border-l-primary data-[active=true]:bg-primary/10 data-[down=true]:bg-rose-500/10", kindTint[c.Kind] } { combatantState(c)... }>
		<div class="flex items-center gap-3">
			@portrait(c, "size-10")
			<div class="flex min-w-0 flex-1 flex-wrap items-center gap-1">
				@combatantName(c)
				@markerText(c)
				@turnBadges(c)
			</div>
			<div class="text-3xl font-semibold">
				@hpText(c)
			</div>
		</div>
		@hpMeter(c, "w-full")
		@hpQuickForm(fmt.Sprintf("/characters/%d/cmd", c.CharacterID), true)
		@conditionList(c.Conditions, true)
	</div>
}

// combatantChip is someone else in the fight as a player sees it: one pill
// in a wrapping row, coloured by type, with no initiative. It shows its first
// conditions and a "+N" for the rest, so it stays one line beside the others;
// the radius is half a line's height, so a phone's wrapped chip clips nothing.
// Downed ones fade.
templ combatantChip(c CombatantView) {
	<li class={ "group/row inline-flex max-w-[min(100%,22rem)] flex-wrap items-center gap-1 rounded-lg border py-0.5 pr-2.5 pl-0.5 text-sm data-[active=true]:border-primary data-[active=true]:bg-primary/10 data-[down=true]:opacity-60", kindBorder[c.Kind] } { combatantState(c)... }>
		@portrait(c, "size-6 group-data-[down=true]/row:grayscale")
		<span class="min-w-0 truncate">
			@combatantName(c)
		</span>
		@turnBadge(c)
		@markerText(c)
		@hpShort(c)
		@downBadge(c)
		for _, cond := range c.Conditions[:min(len(c.Conditions), chipConditions)] {
			@combatCondition(cond, false)
		}
		if len(c.Conditions) > chipConditions {
			@conditionsPopover(c)
		}
	</li>
}

// conditionsPopover is a chip's "+N": it opens every condition with its
// summary written out, as tooltips are hard to reach on a phone.
templ conditionsPopover(c CombatantView) {
	@popover.Popover(popover.Props{ID: fmt.Sprintf("conds-%d", c.ID)}) {
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeXs, Class: "h-[18px] rounded-full border border-violet-500/40 bg-violet-500/10 px-1.5 text-xs font-normal", Attributes: with(popover.Trigger(ctx), templ.Attributes{"aria-label": fmt.Sprintf("All %d conditions", len(c.Conditions))})}) {
			{ fmt.Sprintf("+%d", len(c.Conditions)-chipConditions) }
		}
		// Never taller than the room on its side (--available-height), scrolling inside.
		@popover.Content(popover.ContentProps{Class: "w-72 max-h-[min(24rem,var(--available-height,24rem))] overflow-y-auto overscroll-contain text-sm"}) {
			@popover.Header() {
				@popover.Title() {
					{ c.Name }
				}
			}
			<ul class="space-y-1.5">
				for _, cond := range c.Conditions {
					<li>
						<span class="font-medium capitalize">{ conditionLabel(cond) }</span>
						if tip, ok := dnd5e.ConditionSummaries[cond.Slug]; ok {
							<p class="text-xs text-muted-foreground">{ tip }</p>
						}
					</li>
				}
			</ul>
		}
	}
}

// markerText names the piece on the table that stands for the combatant.
templ markerText(c CombatantView) {
	if c.Marker != "" {
		<span class="inline-flex items-center gap-0.5 text-xs text-muted-foreground" title="Table marker">
			@icon.Tag(icon.Props{Size: 12})
			{ c.Marker }
		</span>
	}
}

// hpShort is HP with a heart, when the viewer may see it.
templ hpShort(c CombatantView) {
	if c.ShowHP {
		<span class="inline-flex items-center gap-0.5 text-xs">
			@icon.Heart(icon.Props{Size: 12, Class: "text-rose-600"})
			@hpText(c)
			@hpMeter(c, "w-8")
		</span>
	}
}

// hpMeter is HP as a bar, red once at half or below; only when the viewer
// sees the HP and there is a max to measure against.
templ hpMeter(c CombatantView, class string) {
	if c.hasMeter() {
		<meter
			class={ "hp-meter", class }
			min="0"
			max={ fmt.Sprint(c.MaxHP) }
			low={ fmt.Sprint(c.MaxHP/2 + 1) }
			optimum={ fmt.Sprint(c.MaxHP) }
			value={ fmt.Sprint(c.HP) }
			aria-hidden="true"
			{ bind("value="+combatantKey(c, "hpval"))... }
		></meter>
	}
}

func (c CombatantView) hasMeter() bool { return c.ShowHP && c.MaxHP > 0 }

// conditionList marks a combatant's conditions as such, in the violet the
// GM's conditions box uses.
templ conditionList(conds []sqlc.Condition, removable bool) {
	if len(conds) > 0 {
		<div class="flex flex-wrap items-center gap-1">
			@icon.Sparkles(icon.Props{Size: 14, Class: "text-violet-600", Attributes: templ.Attributes{"role": "img", "aria-label": "Conditions"}})
			for _, cond := range conds {
				@combatCondition(cond, removable)
			}
		</div>
	}
}

// combatantState marks whose turn it is and who is down; live updates flip
// these attributes.
func combatantState(c CombatantView) templ.Attributes {
	a := templ.Attributes{"data-active": fmt.Sprint(c.Active), "data-down": fmt.Sprint(c.down())}
	return with(a, bind("data-active="+combatantKey(c, "on"), "data-down="+combatantKey(c, "down")))
}

templ portrait(c CombatantView, size string) {
	if c.Portrait != "" {
		<img src={ c.Portrait } alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden=true;this.nextElementSibling.hidden=false" class={ "shrink-0 rounded-full border object-cover", size }/>
	}
	<span aria-hidden="true" hidden?={ c.Portrait != "" } class={ "shrink-0 rounded-full border bg-muted text-muted-foreground text-xs font-medium flex items-center justify-center select-none", size }>{ initials(c.Name) }</span>
}

// initials is the first letter of the name's first two words ("Goblin 2" → "G2").
func initials(name string) string {
	words := strings.Fields(name)
	var b strings.Builder
	for _, w := range words[:min(2, len(words))] {
		b.WriteString(strings.ToUpper(string([]rune(w)[0])))
	}
	return b.String()
}

// combatantName links the combatant's page when the viewer may open it.
templ combatantName(c CombatantView) {
	if c.Link != "" {
		<a href={ templ.SafeURL(c.Link) } target="_blank" class="hover:underline group-data-[active=true]/row:font-semibold">{ c.Name }</a>
	} else {
		<span class={ "group-data-[active=true]/row:font-semibold", templ.KV("font-semibold", c.IsOwn) }>{ c.Name }</span>
	}
}

templ beingBadge(c CombatantView) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
		{ kindLabel[c.Kind] }
	}
}

// turnBadges show whose turn it is and who is down.
templ turnBadges(c CombatantView) {
	@turnBadge(c)
	@downBadge(c)
}

templ turnBadge(c CombatantView) {
	<span hidden?={ !c.Active } { bind("show="+combatantKey(c, "on"))... }>
		@badge.Badge() {
			Turn
		}
	</span>
}

// downBadge shows to everyone, as being down is no secret even when HP is.
templ downBadge(c CombatantView) {
	<span hidden?={ !c.down() } { bind("show="+combatantKey(c, "down"))... }>
		@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
			@icon.Skull()
			Down
		}
	</span>
}

// combatCondition is a condition whose summary opens on click, as phones
// cannot hover, and a remove button beside it for those who may end it. A
// custom condition has no summary: its note is the description.
templ combatCondition(cond sqlc.Condition, removable bool) {
	<span class={ "inline-flex items-center rounded-full border border-violet-500/40 bg-violet-500/10 text-xs capitalize", templ.KV("pr-0.5", removable) }>
		if tip, ok := dnd5e.ConditionSummaries[cond.Slug]; ok {
			@popover.Popover(popover.Props{ID: fmt.Sprintf("condinfo-%d", cond.ID)}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-auto rounded-full px-1.5 py-0 text-xs font-normal capitalize hover:bg-violet-500/20 dark:hover:bg-violet-500/20", Attributes: popover.Trigger(ctx)}) {
					{ conditionLabel(cond) }
				}
				@popover.Content(popover.ContentProps{Class: "w-64 text-sm"}) {
					@popover.Header() {
						@popover.Title(popover.TitleProps{Class: "capitalize"}) {
							{ conditionLabel(cond) }
						}
					}
					<p class="text-muted-foreground">{ tip }</p>
				}
			}
		} else {
			<span class="px-1.5">{ conditionLabel(cond) }</span>
		}
		if removable {
			@removeButton(fmt.Sprintf("/conditions/%d/delete", cond.ID))
		}
	</span>
}

// conditionDialog is the GM's add-condition button and form for one
// combatant; it closes only when the server accepts the condition.
templ conditionDialog(c CombatantView) {
	{{ id := fmt.Sprintf("cond-%d", c.ID) }}
	@dialog.Dialog() {
		@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: dialog.Trigger(ctx)}) {
			@icon.Plus()
			Condition
		}
		@dialog.Content() {
			<form
				class="grid gap-4"
				hx-post={ fmt.Sprintf("/combatants/%d/condition", c.ID) }
				hx-on::after-request="if (event.detail.successful) { this.note.value = ''; this.rounds.value = ''; this.querySelector('[data-slot=dialog-close]').click() }"
				onchange={ templ.JSUnsafeFuncCall(customToggleJS) }
			>
				@dialog.Header() {
					@dialog.Title() {
						Add condition to { c.Name }
					}
				}
				@field.Group(field.GroupProps{Class: "gap-4"}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@field.Label(field.LabelProps{For: id + "-trigger"}) {
							Condition
						}
						@formSelect(id, "slug", conditionItems(), "", "w-48 capitalize", "capitalize")
					}
					@field.Field() {
						@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
							@field.Label(field.LabelProps{For: id + "-note"}) {
								Note
							}
							@input.Input(input.Props{ID: id + "-note", Name: "note", Class: "w-48"})
						}
						@field.Description(field.DescriptionProps{Attributes: templ.Attributes{"data-custom-hint": true, "hidden": true}}) {
							Required for custom: it's the only description of the effect.
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@field.Label(field.LabelProps{For: id + "-rounds"}) {
							Rounds
						}
						@input.Input(input.Props{ID: id + "-rounds", Name: "rounds", Type: "number", Placeholder: "∞", Class: "w-20", Attributes: templ.Attributes{"min": "1"}})
					}
				}
				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Add
					}
				}
			</form>
		}
	}
}

// hpText is a combatant's HP as the viewer may see it.
templ hpText(c CombatantView) {
	<span class="tabular-nums">
		if c.ShowHP {
			<span class="group-data-[down=true]/row:text-rose-600" { bind("text="+combatantKey(c, "hp"))... }>{ fmt.Sprintf("%d/%d", c.HP, c.MaxHP) }</span>
			if c.TempHP > 0 {
				<span class="text-sky-600" { bind("text="+combatantKey(c, "temp"))... }>{ fmt.Sprintf("+%d", c.TempHP) }</span>
			}
		} else {
			<span class="text-muted-foreground" title="HP hidden">—</span>
		}
	</span>
}

// hpQuickForm damages, heals or adds temporary HP through a character's
// commands: on the sheet, and on the player's own row in combat (compact).
templ hpQuickForm(cmdURL string, compact bool) {
	{{ size := utils.IfElse(compact, button.SizeXs, button.SizeSm) }}
	<form class="flex items-center gap-2" hx-post={ cmdURL } hx-on::after-request="this.reset()">
		@input.Input(input.Props{Name: "hp_amount", Type: "number", Class: utils.IfElse(compact, "h-6 w-16", "w-20"), Placeholder: "0", Required: true, Attributes: templ.Attributes{"min": "1", "inputmode": "numeric", "aria-label": "Hit points"}})
		@button.Button(button.Props{Type: button.TypeSubmit, Size: size, Variant: button.VariantDestructive, Attributes: templ.Attributes{"name": "hp_op", "value": "damage"}}) {
			Damage
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Size: size, Attributes: templ.Attributes{"name": "hp_op", "value": "heal"}}) {
			Heal
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Size: size, Variant: button.VariantOutline, Attributes: templ.Attributes{"name": "hp_op", "value": "temp"}}) {
			Temp
		}
	</form>
}

// initiativeInput is the GM's initiative field, with a button that rolls
// d20 plus the combatant's bonus.
templ initiativeInput(c CombatantView) {
	{{ url := fmt.Sprintf("/combatants/%d/initiative", c.ID) }}
	// A set initiative reads as the ladder's rung number, still editable in place.
	@inputgroup.InputGroup(inputgroup.Props{Class: utils.CN("h-9 w-24 shrink-0", utils.IfElse(c.Initiative == "", "ring-2 ring-amber-500/60", "border-transparent bg-transparent shadow-none dark:bg-transparent"))}) {
		@inputgroup.Input(inputgroup.InputProps{Name: "initiative", Value: c.Initiative, Class: utils.CN("px-1 text-center tabular-nums", utils.IfElse(c.Initiative == "", "", "text-2xl font-semibold md:text-2xl")), Attributes: templ.Attributes{
			"inputmode": "numeric", "aria-label": "Initiative", "hx-post": url, "hx-trigger": "change",
		}})
		// Rolling is for setting it; a set initiative is changed by typing.
		if c.Initiative == "" {
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				@inputgroup.Button(inputgroup.ButtonProps{Size: inputgroup.ButtonSizeXs, Variant: button.VariantGhost, Attributes: templ.Attributes{
					"aria-label": fmt.Sprintf("Roll initiative (d20%+d)", c.InitMod), "title": fmt.Sprintf("Roll d20%+d", c.InitMod),
					"hx-post": url, "hx-vals": `{"roll":"1"}`,
				}}) {
					@icon.Dices()
					<span class="text-xs tabular-nums">{ fmt.Sprintf("%+d", c.InitMod) }</span>
				}
			}
		}
	}
}

// turnCard shows whose turn it was, is and comes next, with the GM's
// buttons to move it. The names are bound, so a turn change patches them.
// Below, the GM sees whose turns were skipped and whose initiative is missing.
templ turnCard(e EncounterView) {
	{{ prev, cur, next := e.turnNames() }}
	<div class="space-y-2 rounded-lg border border-primary/40 bg-primary/5 p-2 sm:p-3">
		<div class="flex items-center gap-2 sm:gap-4">
			@turnControls(e, prev, cur, next)
		</div>
		if e.IsGM {
			{{ skipped := e.turnSkipped() }}
			// Eases in and out, so a turn change doesn't make the card jump.
			<p class="flex items-center gap-1.5 overflow-hidden border-t border-primary/20 pt-2 text-xs text-muted-foreground transition-[height,opacity,padding,border-width,visibility] duration-300 ease-out [interpolate-size:allow-keywords] motion-reduce:transition-none data-closed:invisible data-closed:h-0 data-closed:border-t-0 data-closed:pt-0 data-closed:opacity-0" data-closed?={ skipped == "" } { bind("reveal=turn.skipped")... }>
				@icon.Info(icon.Props{Size: 14, Class: "shrink-0"})
				<span { bind("text=turn.skipped")... }>{ skipped }</span>
			</p>
			if !e.initiativeSet() {
				<p class="flex items-center gap-1.5 border-t border-primary/20 pt-2 text-xs text-amber-700 dark:text-amber-300">
					@icon.TriangleAlert(icon.Props{Size: 14, Class: "shrink-0"})
					Next turn needs everyone's initiative. Missing: { strings.Join(e.missingInitiative(), ", ") }
				</p>
			}
		}
	</div>
}

templ turnControls(e EncounterView, prev, cur, next string) {
	if e.IsGM {
		@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantGhost, Disabled: !e.initiativeSet(), Attributes: templ.Attributes{"hx-post": e.url("prev"), "aria-label": "Previous turn", "data-turn-button": true}}) {
			@icon.ChevronLeft()
			<span class="max-sm:hidden">Previous</span>
		}
	}
	<div class="grid min-w-0 flex-1 grid-cols-[1fr_2fr_1fr] items-end gap-2 text-center text-sm">
		@turnSlot("Previous", prev, "turn.prev", "text-muted-foreground")
		@turnSlot("Now", cur, "turn.cur", "text-xl font-semibold sm:text-2xl")
		@turnSlot("Next", next, "turn.next", "text-muted-foreground")
	</div>
	if e.IsGM {
		@button.Button(button.Props{Size: button.SizeLg, Disabled: !e.initiativeSet(), Attributes: templ.Attributes{"hx-post": e.url("next"), "aria-label": "Next turn", "data-turn-button": true}}) {
			<span class="max-sm:hidden">Next turn</span>
			@icon.ChevronRight()
		}
	}
}

templ turnSlot(label, name, key, class string) {
	<div class="min-w-0">
		<div class="text-xs text-muted-foreground">{ label }</div>
		<div class={ "truncate", class } { bind("text="+key)... }>{ name }</div>
	</div>
}

// hpDialog is the GM's HP button: it opens a form to set HP, max HP (a
// monster's only; a PC's lives on their sheet) and temporary HP, and one to
// damage or heal.
templ hpDialog(c CombatantView) {
	{{ id := fmt.Sprintf("hp-%d", c.ID) }}
	@dialog.Dialog() {
		@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Class: "bg-background", Attributes: with(dialog.Trigger(ctx), templ.Attributes{"title": "Change HP"})}) {
			@hpText(c)
		}
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					HP for { c.Name }
				}
			}
			// Only changed fields are sent, so a value someone else changed meanwhile
			// is not undone. HP may not go above the max HP being set, or else the
			// current one.
			<form
				class="grid gap-3"
				hx-post={ fmt.Sprintf("/combatants/%d/hp", c.ID) }
				hx-on:input="this.hp.max = Number(this.max_hp.value) || this.hp.dataset.max; event.target.reportValidity()"
				hx-on::config-request="for (const el of this.querySelectorAll('input[type=number]')) if (el.value === el.defaultValue) delete event.detail.parameters[el.name]"
				hx-on::after-request="if (event.detail.successful) { this.reset(); this.hp.max = this.hp.dataset.max; this.closest('[data-slot=dialog-content]').querySelector('[data-slot=dialog-close]').click() }"
			>
				<input type="hidden" name="op" value="set"/>
				<div class="grid grid-cols-3 gap-2">
					@hpSetField(id+"-hp", "hp", "HP", fmt.Sprint(c.HP), 0, c.hpCap(), bind("value="+combatantKey(c, "hpval")), false)
					// A monster without stats has no max HP yet.
					@hpSetField(id+"-max", "max_hp", "Max HP", utils.IfElse(c.MaxHP > 0, fmt.Sprint(c.MaxHP), ""), 1, MaxHPInput, nil, c.CharacterID != 0)
					@hpSetField(id+"-temp", "temp_hp", "Temp HP", fmt.Sprint(c.TempHP), 0, MaxHPInput, bind("value="+combatantKey(c, "tempval")), false)
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "justify-self-end"}) {
					Set
				}
			</form>
			<form class="grid gap-4 border-t pt-4" hx-post={ fmt.Sprintf("/combatants/%d/hp", c.ID) } hx-on::after-request="if (event.detail.successful) { this.reset(); this.closest('[data-slot=dialog-content]').querySelector('[data-slot=dialog-close]').click() }">
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@field.Label(field.LabelProps{For: id + "-amount"}) {
						Amount
					}
					@input.Input(input.Props{ID: id + "-amount", Name: "amount", Type: "number", Class: "w-24", Attributes: templ.Attributes{"min": "0", "max": fmt.Sprint(MaxHPInput), "inputmode": "numeric", "autofocus": true}})
				}
				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Cancel
					}
					// Damage comes first in the markup so Enter submits it.
					<div class="flex flex-row-reverse gap-2">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"name": "op", "value": "damage"}}) {
							Damage
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Attributes: templ.Attributes{"name": "op", "value": "heal"}}) {
							Heal
						}
					</div>
				}
			</form>
		}
	}
}

// hpSetField is one of the HP dialog's set inputs; disabled for a PC's max
// HP, which the GM may not edit. Live updates set its value attribute, which
// shows unless the GM has typed in the field.
templ hpSetField(id, name, label, value string, minimum, maximum int64, bound templ.Attributes, disabled bool) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) {
			{ label }
		}
		@input.Input(input.Props{ID: id, Name: name, Type: "number", Value: value, Disabled: disabled, Attributes: with(bound, templ.Attributes{"min": fmt.Sprint(minimum), "max": fmt.Sprint(maximum), "data-max": fmt.Sprint(maximum), "inputmode": "numeric"})})
	}
}

// conditionTip is the hover summary for a condition chip's tooltip; custom
// effects have none, their note is the description.
templ conditionTip(slug string) {
	if tip, ok := dnd5e.ConditionSummaries[slug]; ok {
		@tooltip.Content() {
			{ tip }
		}
	}
}

// hpCap is the highest HP the dialog accepts: the max HP, or any value while
// a monster has no stats yet.
func (c CombatantView) hpCap() int64 {
	if c.MaxHP > 0 {
		return c.MaxHP
	}
	return MaxHPInput
}

// initiativeSet reports whether every combatant has an initiative, which
// next turn needs to follow the order.
func (e EncounterView) initiativeSet() bool { return len(e.missingInitiative()) == 0 }

// missingInitiative names the combatants without an initiative.
func (e EncounterView) missingInitiative() []string {
	var names []string
	for _, c := range e.Combatants {
		if c.Initiative == "" {
			names = append(names, c.Name)
		}
	}
	return names
}

// turnNames are the previous, current and next combatants in the fight,
// passing over those out of it as next turn does.
func (e EncounterView) turnNames() (prev, cur, next string) {
	n := len(e.Combatants)
	i := slices.IndexFunc(e.Combatants, func(c CombatantView) bool { return c.Active })
	if i < 0 {
		return "", "", ""
	}
	near := func(dir int) string {
		for k := 1; k < n; k++ {
			if c := e.Combatants[((i+dir*k)%n+n)%n]; !c.Out {
				return c.Name
			}
		}
		return ""
	}
	return near(-1), e.Combatants[i].Name, near(1)
}

// turnSkipped names those out of the fight between the previous turn and
// this one, whose turns next turn passed over; empty when there are none.
func (e EncounterView) turnSkipped() string {
	n := len(e.Combatants)
	i := slices.IndexFunc(e.Combatants, func(c CombatantView) bool { return c.Active })
	if i < 0 {
		return ""
	}
	var names []string
	for k := 1; k < n; k++ {
		c := e.Combatants[((i-k)%n+n)%n]
		if !c.Out {
			break
		}
		names = append(names, c.Name)
	}
	if len(names) == 0 {
		return ""
	}
	slices.Reverse(names)
	return fmt.Sprintf("Skipped %d (out of the fight): %s", len(names), strings.Join(names, ", "))
}

// combatantGroup is one kind of being in a player's grid.
type combatantGroup struct {
	Kind, Label string
	Cards       []CombatantView
}

// playerGroups are the others in the fight grouped by kind and sorted by
// name, so the grid does not give the initiative order away.
func (e EncounterView) playerGroups() []combatantGroup {
	var groups []combatantGroup
	for _, kind := range []string{KindPC, KindNPC, KindMonster} {
		g := combatantGroup{Kind: kind, Label: kindGroup[kind]}
		for _, c := range e.Combatants {
			if c.Kind == kind && !c.IsOwn {
				g.Cards = append(g.Cards, c)
			}
		}
		if len(g.Cards) == 0 {
			continue
		}
		slices.SortStableFunc(g.Cards, func(a, b CombatantView) int {
			ab, an := nameKey(a.Name)
			bb, bn := nameKey(b.Name)
			if c := strings.Compare(strings.ToLower(ab), strings.ToLower(bb)); c != 0 {
				return c
			}
			return an - bn
		})
		groups = append(groups, g)
	}
	return groups
}

// nameKey splits a trailing number off a name, so "Bandit 2" sorts before
// "Bandit 10".
func nameKey(name string) (string, int) {
	i := strings.LastIndexByte(name, ' ')
	if i < 0 {
		return name, 0
	}
	n, err := strconv.Atoi(name[i+1:])
	if err != nil {
		return name, 0
	}
	return name[:i], n
}

// customToggleJS makes the note required, and says why, while "custom…" is
// the chosen condition. It runs on the form's change events.
var customToggleJS = fmt.Sprintf(`const custom = this.slug.value === %q; this.note.required = custom; this.querySelector("[data-custom-hint]").hidden = !custom`, dnd5e.TrackCustom)

func conditionItems() []selectcomp.ItemData {
	var items []selectcomp.ItemData
	for _, slug := range dnd5e.Conditions {
		items = append(items, selectcomp.ItemData{Value: slug, Label: slug})
	}
	return append(items,
		selectcomp.ItemData{Value: dnd5e.TrackConcentration, Label: "concentration"},
		selectcomp.ItemData{Value: dnd5e.TrackCustom, Label: "custom…"},
	)
}

// quietDestructive styles the small × removes that repeat on every row or
// chip: muted until hovered, so a list is not a wall of red.
const quietDestructive = "text-muted-foreground hover:bg-destructive/10 hover:text-destructive dark:hover:bg-destructive/20"

// removeButton is the small × inside a condition chip.
templ removeButton(url string) {
	@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconXs, Class: "size-4 " + quietDestructive, Attributes: templ.Attributes{"aria-label": "Remove", "hx-post": url}}) {
		@icon.X(icon.Props{Size: 12})
	}
}

// selectItems maps xs to select items with the given value and label.
func selectItems[T any](xs []T, value, label func(T) string) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(xs))
	for _, x := range xs {
		items = append(items, selectcomp.ItemData{Value: value(x), Label: label(x)})
	}
	return items
}

// formSelect is a shadcn select that submits name, preselecting value (or
// the first item when empty); its list scrolls rather than running to the
// screen edge. An empty id gets a random one.
templ formSelect(id, name string, items []selectcomp.ItemData, value, class, contentClass string) {
	if value == "" && len(items) > 0 {
		{{ value = items[0].Value }}
	}
	@selectcomp.Select(selectcomp.Props{ID: id, Name: name, Items: items, DefaultValue: value}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: class}) {
			@selectcomp.Value()
		}
		// Opens below the trigger: aligning the selected item with it would push
		// the list up the screen once a later item is chosen.
		@selectcomp.Content(selectcomp.ContentProps{Class: utils.CN("max-h-60", contentClass), AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
			for _, it := range items {
				@selectcomp.Item(selectcomp.ItemProps{Value: it.Value}) {
					{ fmt.Sprint(it.Label) }
				}
			}
		}
	}
}

func visibleTitle(on bool) string {
	if on {
		return "Players see this HP (click to hide)"
	}
	return "HP hidden from players (click to show)"
}

func conditionLabel(c sqlc.Condition) string {
	label := c.Slug
	if c.Slug == dnd5e.TrackCustom {
		label = c.Note // a custom condition's note is its name
	} else if c.Note != "" {
		label += " " + c.Note
	}
	if c.ExpiresRound.Valid {
		label += fmt.Sprintf(" (to round %d)", c.ExpiresRound.Int64)
	}
	return label
}

// addCombatants is the GM's add form, a tab per type of being. PCs and NPCs
// already in the fight are marked but may be added again.
templ addCombatants(e EncounterView) {
	{{ var pcs, npcs []selectcomp.ItemData }}
	for _, ch := range e.Characters {
		{{ pcs = append(pcs, selectcomp.ItemData{Value: fmt.Sprint(ch.ID), Label: ch.Name + inFightSuffix(e.inFight(func(c CombatantView) bool { return c.CharacterID == ch.ID }))}) }}
	}
	for _, en := range e.Entities {
		{{ npcs = append(npcs, selectcomp.ItemData{Value: fmt.Sprint(en.ID), Label: en.Name + inFightSuffix(e.inFight(func(c CombatantView) bool { return c.EntityID == en.ID }))}) }}
	}
	@tabs.Tabs(tabs.Props{ID: fmt.Sprintf("add-combatant-%d", e.Encounter.ID), DefaultValue: KindMonster}) {
		@tabs.List(tabs.ListProps{Class: "w-fit"}) {
			@tabs.Trigger(tabs.TriggerProps{Value: KindPC}) {
				PC
			}
			@tabs.Trigger(tabs.TriggerProps{Value: KindNPC}) {
				NPC
			}
			@tabs.Trigger(tabs.TriggerProps{Value: KindMonster}) {
				Monster
			}
		}
		@tabs.Content(tabs.ContentProps{Value: KindPC}) {
			@addCombatantForm(e, "pc", KindPC, "Add PC", pcs)
		}
		@tabs.Content(tabs.ContentProps{Value: KindNPC}) {
			@addCombatantForm(e, "entity", KindNPC, "Add NPC", npcs)
		}
		@tabs.Content(tabs.ContentProps{Value: KindMonster}) {
			// The result buttons post this form's count and HP switch with the
			// monster; Enter in the search must not submit it.
			<form class="flex flex-wrap items-center gap-3" onsubmit="event.preventDefault()">
				// Results float above the input while it (or a result) has focus; the
				// list is focusable so a click on a result keeps focus inside (Safari).
				<div class="group/monster relative min-w-0 flex-1">
					@input.Input(input.Props{Type: "search", Name: "q", Placeholder: "Search monsters…", Attributes: templ.Attributes{
						"autocomplete": "off",
						"hx-get":       fmt.Sprintf("/compendium/search?kind=monster&encounter=%d", e.Encounter.ID),
						"hx-trigger":   "input changed delay:200ms, search",
						"hx-target":    "next ul",
						"hx-swap":      "innerHTML",
					}})
					<ul tabindex="-1" class="absolute bottom-full z-10 mb-1 max-h-64 w-full overflow-auto rounded-md border bg-popover p-1 text-sm text-popover-foreground shadow outline-none empty:hidden not-group-focus-within/monster:hidden"></ul>
				</div>
				@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "w-auto"}) {
					@field.Label(field.LabelProps{For: fmt.Sprintf("add-count-%d", e.Encounter.ID)}) {
						Count
					}
					@input.Input(input.Props{ID: fmt.Sprintf("add-count-%d", e.Encounter.ID), Name: "count", Type: "number", Value: "1", Class: "w-16", Attributes: templ.Attributes{"min": "1", "max": "20", "inputmode": "numeric"}})
				}
				@hpVisibleSwitch(e, KindMonster)
			</form>
		}
	}
}

templ addCombatantForm(e EncounterView, kind, tab, label string, items []selectcomp.ItemData) {
	<form class="flex flex-wrap items-center gap-3" hx-post={ e.url("combatants") }>
		<input type="hidden" name="kind" value={ kind }/>
		@formSelect(fmt.Sprintf("add-%s-%d", kind, e.Encounter.ID), "id", items, "", "min-w-48 flex-1", "")
		@hpVisibleSwitch(e, tab)
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
			{ label }
		}
	</form>
}

// hpVisibleSwitch picks whether players see a new combatant's HP; app.js
// remembers the choice per tab in this browser.
templ hpVisibleSwitch(e EncounterView, tab string) {
	{{ id := fmt.Sprintf("add-hp-%s-%d", tab, e.Encounter.ID) }}
	@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "w-auto"}) {
		@switchcomp.Switch(switchcomp.Props{ID: id, Name: "hp_visible", Value: "true", Attributes: templ.Attributes{"data-remember": "add-hp-visible-" + tab}})
		@field.Label(field.LabelProps{For: id}) {
			HP visible to players
		}
	}
}

// inFight reports whether a combatant matching f is already in the fight.
func (e EncounterView) inFight(f func(CombatantView) bool) bool {
	return slices.ContainsFunc(e.Combatants, f)
}

func inFightSuffix(in bool) string { return utils.IfElse(in, " (already in fight)", "") }
