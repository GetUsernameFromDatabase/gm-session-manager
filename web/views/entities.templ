package views

import (
	"cmp"
	"fmt"
	"gm-session-manager/db/sqlc"
	"gm-session-manager/perm"
	"gm-session-manager/web/components/badge"
	"gm-session-manager/web/components/button"
	"gm-session-manager/web/components/combobox"
	"gm-session-manager/web/components/dialog"
	"gm-session-manager/web/components/empty"
	"gm-session-manager/web/components/icon"
	switchcomp "gm-session-manager/web/components/switch"
	"gm-session-manager/web/components/input"
	"gm-session-manager/web/components/textarea"
	"gm-session-manager/web/components/tooltip"
	"gm-session-manager/web/utils"
	"slices"
)

// SuggestedFields are the NPC fields offered when creating or editing an
// entity. They are a frontend recommendation only: any key may be stored.
var SuggestedFields = []string{
	"role", "description", "appearance", "personality", "motivation",
	"location", "faction", "relationship to the party", "stat block", "gm notes",
}

// OrderedFieldKeys lists suggested keys first, in order, then the rest
// alphabetically.
func OrderedFieldKeys(f perm.Fields) []string {
	var keys []string
	for _, k := range SuggestedFields {
		if _, ok := f[k]; ok {
			keys = append(keys, k)
		}
	}
	var rest []string
	for k := range f {
		if !slices.Contains(SuggestedFields, k) {
			rest = append(rest, k)
		}
	}
	slices.Sort(rest)
	return append(keys, rest...)
}

// EntityListView is the NPC index.
type EntityListView struct {
	CampaignID int64
	Entities   []perm.Entity
	IsGM       bool
}

templ EntitiesPage(l Layout, v EntityListView) {
	@Page(l) {
		<div class="mb-6 flex flex-wrap items-center gap-2">
			<h1 class="mr-auto text-2xl font-semibold">NPCs</h1>
			if v.IsGM {
				@newEntityDialog(v.CampaignID)
			}
		</div>
		@EntityList(v)
	}
}

const newEntityID = "new-npc"

templ newEntityDialog(campaignID int64) {
	@dialog.Dialog(dialog.Props{ID: newEntityID}) {
		@button.Button(button.Props{Attributes: dialog.Trigger(ctx)}) {
			@icon.Plus()
			New NPC
		}
		@dialog.Content() {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/campaigns/%d/entities", campaignID)) } class="grid gap-4">
				@dialog.Header() {
					@dialog.Title() {
						New NPC
					}
					@dialog.Description() {
						Players see a new NPC only once you reveal it.
					}
				}
				@input.Input(input.Props{Name: "name", Placeholder: "Name", Required: true, Attributes: templ.Attributes{"aria-label": "Name"}})
				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create NPC
					}
				}
			</form>
		}
	}
}

// EntityList is the cast: a portrait card per NPC. The GM's hidden NPCs wait
// in the wings, greyed out.
templ EntityList(v EntityListView) {
	<div id="entities-list" hx-swap-oob="true" { live(LiveEntities, v.CampaignID)... }>
		if len(v.Entities) == 0 {
			@empty.Empty(empty.Props{Class: "border border-dashed"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Drama()
					}
					@empty.Title() {
						No NPCs yet
					}
					@empty.Description() {
						if v.IsGM {
							Add the people the party will meet: an innkeeper, a rival, a patron. Players see each one only once you reveal it.
						} else {
							The GM has not revealed any NPCs yet.
						}
					}
				}
				if v.IsGM {
					@empty.Content() {
						// Opens the header's dialog, so its id stays unique.
						@button.Button(button.Props{Attributes: dialog.TriggerFor(newEntityID)}) {
							@icon.Plus()
							New NPC
						}
					}
				}
			}
		} else {
			<ul class="grid grid-cols-2 gap-x-3 gap-y-5 sm:grid-cols-3 lg:grid-cols-5">
				for _, e := range v.Entities {
					<li class="group/npc min-w-0" data-hidden?={ v.IsGM && !e.IsRevealed }>
						<a class="block rounded-lg ring-offset-2 ring-offset-background outline-none focus-visible:ring-3 focus-visible:ring-ring/50" href={ templ.SafeURL(fmt.Sprintf("/entities/%d", e.ID)) }>
							<div class="relative">
								@npcPortrait(e, "group-data-[hidden]/npc:opacity-60 group-data-[hidden]/npc:grayscale")
								if v.IsGM && !e.IsRevealed {
									<span class="absolute top-2 left-2">
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
											@icon.EyeOff()
											Hidden
										}
									</span>
								}
							</div>
							<p class="mt-1.5 truncate text-sm font-medium" title={ e.Name }>{ e.Name }</p>
							if role := e.Fields["role"].Value; role != "" {
								<p class="line-clamp-1 text-xs text-muted-foreground">{ role }</p>
							}
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

// currentLook is the look shown as the portrait.
func currentLook(looks []perm.Look) (perm.Look, bool) {
	i := slices.IndexFunc(looks, func(l perm.Look) bool { return l.IsCurrent })
	if i < 0 {
		return perm.Look{}, false
	}
	return looks[i], true
}

// npcPortrait is the NPC's current look, or their initials without one.
templ npcPortrait(e perm.Entity, class string) {
	if look, ok := currentLook(e.Images); ok {
		<img src={ LookItem(look).Src() } alt={ e.Name } loading="lazy" class={ utils.CN("aspect-square w-full rounded-lg border bg-muted object-cover transition", class) }/>
	} else {
		<div aria-hidden="true" class={ utils.CN("flex aspect-square w-full items-center justify-center rounded-lg border bg-muted font-serif text-4xl text-muted-foreground select-none transition", class) }>{ initials(e.Name) }</div>
	}
}

// EntityView is one entity page.
type EntityView struct {
	CampaignID int64
	E          perm.Entity
	IsGM       bool
	// Compendium is the linked statblock (GM only).
	Compendium *sqlc.CompendiumEntry
	// ActiveEncounterID lets the GM add the NPC to the running fight.
	ActiveEncounterID int64
	// ImageChoices are the campaign's images not yet one of its looks (GM only).
	ImageChoices []sqlc.ListImagesRow
	// Readable are the [[link]] targets in the fields a player may open
	// (keys as WikiLink.Key); the others show as their label.
	Readable    map[string]bool
	Backlinks   []sqlc.ListBacklinksRow
	EntityLinks []sqlc.ListEntityFieldBacklinksRow
}

func (v EntityView) canOpen(l WikiLink) bool { return v.IsGM || v.Readable[l.Key()] }

// entityGrid is the page's two columns: looks, then fields or mentions.
const entityGrid = "grid gap-6 md:grid-cols-[2fr_3fr] md:gap-8"

templ EntityPage(l Layout, v EntityView) {
	@Page(l) {
		@EntityDetail(v)
		<div class={ entityGrid, "mt-10" }>
			<section class="md:col-start-2">
				<h2 class={ sectionHeading }>Linked mentions</h2>
				<ul class="space-y-1.5 text-sm">
					if v.IsGM {
						for _, img := range v.E.Images {
							@mention(icon.Image, fmt.Sprintf("/images/%d", img.ImageID), img.Name)
						}
					}
					@npcMentions(v.EntityLinks)
					for _, b := range v.Backlinks {
						@mention(icon.NotebookPen, fmt.Sprintf("/notes/%d", b.ID), b.Title)
					}
					if len(v.Backlinks) == 0 && len(v.EntityLinks) == 0 && (!v.IsGM || len(v.E.Images) == 0) {
						<li class="text-muted-foreground">No notes mention this NPC yet.</li>
					}
				</ul>
			</section>
		</div>
	}
}

templ EntityDetail(v EntityView) {
	<div id={ fmt.Sprintf("entity-%d", v.E.ID) } hx-swap-oob="true" class={ entityGrid } { live(LiveEntity, v.E.ID)... }>
		// The face leads; on phones the fields follow it.
		<div class="md:sticky md:top-20 md:self-start">
			@entityLooks(v)
		</div>
		<div class="min-w-0">
			if v.IsGM {
				@entityForm(v)
			} else {
				<h1 class="mb-6 text-2xl font-semibold">{ v.E.Name }</h1>
				<dl class="max-w-prose space-y-5">
					for _, k := range OrderedFieldKeys(v.E.Fields) {
						<div>
							<dt class="text-sm font-medium text-muted-foreground first-letter:uppercase">{ k }</dt>
							<dd class="flow-root font-serif text-base leading-relaxed whitespace-pre-line">
								@wikiText(v.E.Fields[k].Value, v.canOpen)
							</dd>
						</div>
					}
				</dl>
			}
		</div>
	</div>
}

// entityLooks is the NPC's looks, the current one as the portrait; the GM
// manages them.
templ entityLooks(v EntityView) {
	if len(v.E.Images) == 0 {
		<div class="max-w-64 md:max-w-none">
			@npcPortrait(v.E, "")
		</div>
	}
	if v.IsGM || len(v.E.Images) > 0 {
		@looksSection(v.E.Images, utils.IfElse(v.IsGM, fmt.Sprintf("/entities/%d/images/", v.E.ID), ""),
			utils.IfElse(v.IsGM, "The current look is the NPC's portrait. Players see only revealed looks.", "")) {
			if v.IsGM {
				if len(v.ImageChoices) > 0 {
					<form class="flex flex-wrap items-center gap-2" hx-post={ fmt.Sprintf("/entities/%d/images", v.E.ID) }>
						@formSelect("", "image", selectItems(v.ImageChoices, func(i sqlc.ListImagesRow) string { return fmt.Sprint(i.ID) }, func(i sqlc.ListImagesRow) string { return i.Name }), "", "w-56", "")
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
							Add look
						}
					</form>
				} else if len(v.E.Images) == 0 {
					<p class="text-sm text-muted-foreground">Add images on the Images page, then link them here.</p>
				}
			}
		}
	}
}

// looksSection shows looks (an NPC's or a character's), the current one
// first, larger and ringed as the portrait. It only ever gets the looks the
// viewer may see. base is where the look actions live, empty when
// read-only; children add more looks.
templ looksSection(looks []perm.Look, base, hint string) {
	<section class="mt-8 space-y-3 first:mt-0">
		<h2 class={ sectionHeading }>Looks</h2>
		if hint != "" {
			<p class="text-xs text-muted-foreground">{ hint }</p>
		}
		<div class="flex flex-wrap items-start gap-4">
			for _, img := range looks {
				<figure class={ "space-y-1", utils.IfElse(img.IsCurrent, "w-64", "w-32") }>
					<a href={ templ.SafeURL(fmt.Sprintf("/images/%d", img.ImageID)) } class="block rounded-lg">
						<img src={ LookItem(img).Src() } alt={ img.Name } loading="lazy" class={ "aspect-square w-full rounded-lg border bg-muted object-cover", templ.KV("ring-2 ring-primary ring-offset-2 ring-offset-background", img.IsCurrent) }/>
					</a>
					<figcaption class="truncate text-xs" title={ img.Name }>
						{ img.Name }
						if img.IsCurrent {
							<span class="sr-only">(current)</span>
						}
					</figcaption>
					if base != "" {
						@lookControls(base+fmt.Sprint(img.ImageID)+"/", img)
					}
				</figure>
			}
		</div>
		{ children... }
	</section>
}

// lookControls are the buttons under a look: reveal or hide, make current,
// unlink. base is the look's action URL prefix.
templ lookControls(base string, img perm.Look) {
	<div class="flex items-center gap-1">
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconXs, Class: "aria-pressed:text-primary text-muted-foreground", Attributes: templ.Attributes{
			"hx-post": base + "reveal", "aria-pressed": fmt.Sprint(img.IsRevealed), "title": utils.IfElse(img.IsRevealed, "Revealed to players", "Hidden from players"),
		}}) {
			if img.IsRevealed {
				@icon.Eye(icon.Props{Size: 14})
			} else {
				@icon.EyeOff(icon.Props{Size: 14})
			}
		}
		if !img.IsCurrent {
			@button.Button(button.Props{Variant: button.VariantLink, Size: button.SizeXs, Class: "px-0", Attributes: templ.Attributes{"hx-post": base + "current"}}) {
				Make current
			}
		}
		<span class="ml-auto">
			@removeButton(base + "unlink")
		</span>
	</div>
}

// LookItem is a look as an image to load.
func LookItem(img perm.Look) ImageItem {
	return ImageItem{ID: img.ImageID, Name: img.Name, Version: img.Version}
}

// EntityGone replaces an entity's page content when it is hidden or
// deleted while a player is looking at it.
templ EntityGone(id int64) {
	<div id={ fmt.Sprintf("entity-%d", id) } hx-swap-oob="true" { live(LiveEntity, id)... }>
		@empty.Empty(empty.Props{Class: "border border-dashed"}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.EyeOff()
				}
				@empty.Title() {
					This NPC is not available
				}
			}
		}
	</div>
}

templ entityForm(v EntityView) {
	{{ keys := OrderedFieldKeys(v.E.Fields) }}
	<form hx-post={ fmt.Sprintf("/entities/%d", v.E.ID) } class="group/fields space-y-5">
		<div class="space-y-2">
			<div class="flex items-center gap-2">
				@input.Input(input.Props{Name: "name", Value: v.E.Name, Required: true, Class: "-ml-2.5 h-auto border-transparent py-0.5 text-2xl font-semibold shadow-none hover:border-input md:text-2xl dark:bg-transparent", Attributes: templ.Attributes{"aria-label": "Name"}})
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: quietDestructive, Attributes: templ.Attributes{
					"hx-post": fmt.Sprintf("/entities/%d/delete", v.E.ID), "hx-confirm": "Delete " + v.E.Name + "?", "aria-label": "Delete " + v.E.Name, "title": "Delete",
				}}) {
					@icon.Trash2()
				}
			</div>
			@checkField("revealed", "true", v.E.IsRevealed) {
				Players can see this NPC
			}
		</div>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p class="text-xs text-muted-foreground">
				Players get only the fields marked <span class="text-sky-700 dark:text-sky-300">Players see</span>; the rest never reach their devices.
				<span class="text-amber-600 dark:text-amber-500">Empty fields are not saved.</span>
			</p>
			// Shows the fields as stored, [[links]] as text; it submits nothing.
			<label class="flex items-center gap-2 text-xs text-muted-foreground" data-raw-switch>
				@switchcomp.Switch(switchcomp.Props{Size: switchcomp.SizeSm})
				Raw text
			</label>
		</div>
		<input type="hidden" name="count" value={ fmt.Sprint(len(keys)) }/>
		<div data-field-rows class="peer max-w-prose space-y-5">
			for i, k := range keys {
				@fieldRow(i, k, v.E.Fields[k])
			}
		</div>
		<p class="hidden text-sm text-muted-foreground peer-empty:block">No fields yet.</p>
		<template data-field-row>
			@fieldRow(0, "", perm.Field{})
		</template>
		@addFieldInput(v.E.ID, keys)
		<section class="space-y-1 pt-3 text-sm">
			<h2 class={ sectionHeading }>Statblock</h2>
			<p class="flex items-center gap-1">
				if v.Compendium != nil {
					@icon.BookOpen(icon.Props{Size: 16, Class: "text-muted-foreground"})
					<a class="underline underline-offset-4" href={ templ.SafeURL(fmt.Sprintf("/compendium/entries/%d", v.Compendium.ID)) }>{ v.Compendium.Name }</a>
					@button.Button(button.Props{Variant: button.VariantLink, Size: button.SizeXs, Class: "text-muted-foreground", Attributes: templ.Attributes{"hx-post": fmt.Sprintf("/entities/%d/link", v.E.ID), "hx-vals": `{"entry":"0"}`}}) {
						Unlink
					}
				} else {
					<span class="text-muted-foreground">None linked.</span>
				}
			</p>
			@input.Input(input.Props{Name: "q", Type: "search", Placeholder: "Link a compendium monster…", Class: "max-w-sm", Attributes: templ.Attributes{
				"aria-label": "Link a compendium monster",
				"hx-get":     fmt.Sprintf("/compendium/search?kind=monster&entity=%d", v.E.ID),
				"hx-trigger": "input changed delay:200ms, search",
				"hx-target":  "next ul",
				"hx-swap":    "innerHTML",
			}})
			<ul class="mt-1"></ul>
		</section>
		// Sticky, so a long list of fields need not be scrolled to its end to save.
		<div class="sticky bottom-3 z-30 flex flex-wrap items-center gap-2 rounded-lg border bg-background/95 p-3 shadow-lg backdrop-blur">
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				@icon.Save()
				Save
			}
			if v.ActiveEncounterID != 0 {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{
					"hx-post": fmt.Sprintf("/encounters/%d/combatants", v.ActiveEncounterID), "hx-vals": fmt.Sprintf(`{"kind":"entity","id":"%d"}`, v.E.ID),
				}}) {
					@icon.Swords()
					Add to current fight
				}
			}
		</div>
	</form>
}

func missingSuggestions(keys []string) []string {
	var out []string
	for _, k := range SuggestedFields {
		if !slices.Contains(keys, k) {
			out = append(out, k)
		}
	}
	return out
}

// fieldRow is one stored field: its key, value and whether players see it.
// Its rail is rose while only the GM sees it and sky once players do, as on
// note blocks; the checkbox flips it, no script needed. app.js clones a blank
// one for each field added and removes rows; Save stores what is left.
templ fieldRow(i int, key string, f perm.Field) {
	<div class="group/field space-y-1 border-l-[3px] border-l-rose-500 pl-3 has-[[data-reveal]_[data-checked]]:border-l-sky-500" data-field-key={ key } data-empty?={ f.Value == "" }>
		<div class="flex items-center gap-2">
			<span class="text-sm font-medium first-letter:uppercase" data-field-label>{ key }</span>
			// Shown while the value is empty (fields.js keeps data-empty).
			<span class="hidden group-data-[empty]/field:inline-flex">
				@tooltip.Tooltip() {
					<span class="inline-flex text-amber-600 dark:text-amber-500" tabindex="0" aria-label="Empty fields are not saved" { tooltip.Trigger(ctx)... }>
						@icon.TriangleAlert(icon.Props{Size: 14})
					</span>
					@tooltip.Content() {
						Fields with an empty value are not saved.
					}
				}
			</span>
			<input type="hidden" name={ fmt.Sprintf("key_%d", i) } value={ key }/>
			<span class="ml-auto text-xs" data-reveal>
				@checkField(fmt.Sprintf("revealed_%d", i), "true", f.IsRevealed) {
					Players see
				}
			</span>
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIconXs, Class: "size-4 " + quietDestructive, Attributes: templ.Attributes{"aria-label": "Remove field", "data-remove-field": ""}}) {
				@icon.X(icon.Props{Size: 12})
			}
		</div>
		// The value is the hidden input the form posts: an editor is not a
		// form control. fields.js shows it in an editor that renders [[links]]
		// as notes do, or with Raw text on, as stored in the textarea.
		<input type="hidden" name={ fmt.Sprintf("value_%d", i) } value={ f.Value } data-field-value/>
		<div class="font-serif group-data-[raw]/fields:hidden" data-field-editor></div>
		<div class="hidden group-data-[raw]/fields:block">
			@textarea.Textarea(textarea.Props{Value: f.Value, Rows: 2, Placeholder: "Value", Attributes: templ.Attributes{"aria-label": "Value as stored", "data-field-raw": ""}})
		</div>
	</div>
}

// wikiText is a field value with its [[links]] shown as in notes; a link
// the viewer may not open shows as its label.
templ wikiText(s string, canOpen func(WikiLink) bool) {
	for _, p := range ParseWiki(s) {
		if p.Link == nil {
			{ p.Text }
		} else if canOpen(*p.Link) {
			@wikiLink(*p.Link)
		} else {
			{ p.Link.Label }
		}
	}
}

// wikiLink is one link as notes render it: an [[image]] shows the image.
templ wikiLink(l WikiLink) {
	<a class="wikilink" href={ templ.SafeURL(l.URL()) } data-mention={ l.Key() }
		if l.Kind == "image" {
			data-float={ cmp.Or(l.Float, "left") }
		}
	>
		if l.Kind == "image" {
			<img src={ ImageSrc(l.ID) } alt={ l.Label } loading="lazy"/>
		}
		<span>{ l.Label }</span>
	</a>
}

// npcMentions are the linked-mentions rows for NPCs whose fields link here.
templ npcMentions(rows []sqlc.ListEntityFieldBacklinksRow) {
	for _, e := range rows {
		@mention(icon.Drama, fmt.Sprintf("/entities/%d", e.ID), e.Name)
	}
}

// addFieldInput adds a field row: pick a suggestion not in use or type any
// key (the create button, as for image categories). It submits nothing.
templ addFieldInput(entityID int64, keys []string) {
	{{ id := fmt.Sprintf("add-field-%d", entityID) }}
	<div class="max-w-sm" data-add-field>
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{ID: id, Class: "w-full", Placeholder: "Add a field…", Attributes: templ.Attributes{"maxlength": "100", "aria-label": "Add a field", "data-combobox-create-input": ""}})
			@combobox.Content(combobox.ContentProps{Class: comboEmptyHidden}) {
				@createButton(id)
				@combobox.List() {
					for _, k := range missingSuggestions(keys) {
						@combobox.Item(combobox.ItemProps{Value: k}) {
							{ k }
						}
					}
					<template data-combobox-create-item>
						@combobox.Item()
					</template>
				}
			}
		}
	</div>
}
