package views

import (
	"fmt"
	"gm-session-manager/db/sqlc"
	"gm-session-manager/web/components/button"
	"gm-session-manager/web/components/card"
	"gm-session-manager/web/components/empty"
	"gm-session-manager/web/components/icon"
	"gm-session-manager/web/components/input"
	"gm-session-manager/web/components/label"
	"gm-session-manager/web/components/separator"
	"gm-session-manager/web/components/spinner"
	"strings"
)

// JoinInfo is what the GM shows players so they can connect.
type JoinInfo struct {
	URLs        []string
	QR          string // src of the QR code image
	Fingerprint string
}

templ joinPanel(j JoinInfo) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Players join here
			}
			@card.Description() {
				Scan the code or open the address on a phone on the same network. Each device accepts the certificate warning once.
			}
		}
		@card.Content() {
			// Stacked: the panel often sits in a narrow column, and the URLs need its full width.
			<div class="flex flex-col items-center gap-4">
				if len(j.URLs) > 0 {
					<img src={ j.QR } alt="QR code for the join address" width="224" height="224" class="rounded bg-white p-2"/>
				}
				<div class="w-full space-y-1 text-sm">
					if len(j.URLs) == 0 {
						<p>No private network address found. Connect this PC to the same Wi-Fi as the players.</p>
					}
					for _, u := range j.URLs {
						<div class="flex items-center gap-1">
							<p class="min-w-0 font-mono wrap-anywhere">{ u }</p>
							@button.Button(button.Props{Size: button.SizeIconSm, Variant: button.VariantGhost, Class: "group shrink-0", Attributes: templ.Attributes{"data-copy": u, "aria-label": "Copy join link", "title": "Copy join link"}}) {
								@icon.Copy(icon.Props{Size: 16, Class: "group-data-[copied]:hidden"})
								@icon.Check(icon.Props{Size: 16, Class: "hidden group-data-[copied]:block"})
							}
						</div>
					}
					if len(j.URLs) > 1 {
						<p class="text-xs text-muted-foreground">This PC is on more than one network. If one address doesn't load, try the next.</p>
					}
					<details class="pt-2 text-xs">
						<summary class="cursor-pointer text-muted-foreground">Check the certificate</summary>
						<p class="mt-2 text-muted-foreground">When the browser warns about the certificate, its SHA-256 fingerprint should match:</p>
						<p class="mt-1 font-mono">{ fingerprintPairs(j.Fingerprint) }</p>
					</details>
				</div>
			</div>
		}
	}
}

// fingerprintPairs spaces the hex fingerprint into uppercase byte pairs, as
// Chrome's certificate viewer shows it, so it wraps and can be compared.
func fingerprintPairs(hex string) string {
	var b strings.Builder
	for i := 0; i < len(hex); i += 2 {
		if i > 0 {
			b.WriteByte(' ')
		}
		b.WriteString(strings.ToUpper(hex[i:min(i+2, len(hex))]))
	}
	return b.String()
}

templ GMHome(l Layout, campaigns []sqlc.Campaign, j JoinInfo) {
	@Page(l) {
		@PageHeader("Campaigns", "You are the GM on this device.")
		<div class="grid gap-6 md:grid-cols-2">
			<div class="space-y-3">
				for _, c := range campaigns {
					@campaignRow(fmt.Sprintf("/campaigns/%d", c.ID), c)
				}
				if len(campaigns) == 0 {
					<p class="text-muted-foreground">No campaigns yet.</p>
				}
				<form method="post" action="/campaigns" class="flex gap-2 pt-2">
					@input.Input(input.Props{Name: "name", Placeholder: "New campaign name", Required: true})
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create
					}
				</form>
			</div>
			@joinPanel(j)
		</div>
	}
}

templ campaignRow(href string, c sqlc.Campaign) {
	<a href={ templ.SafeURL(href) } class="flex min-h-14 items-center gap-3 rounded-lg border p-4 hover:bg-accent">
		<div class="min-w-0 flex-1">
			<div class="font-medium">{ c.Name }</div>
			<div class="text-sm text-muted-foreground">{ c.System } { c.Edition }</div>
		</div>
		@icon.ChevronRight(icon.Props{Size: 18, Class: "shrink-0 text-muted-foreground"})
	</a>
}

// narrow keeps the player pages phone-shaped on wide screens.
templ narrow() {
	<div class="mx-auto max-w-md">
		{ children... }
	</div>
}

templ JoinCampaigns(l Layout, campaigns []sqlc.Campaign) {
	@Page(l) {
		@narrow() {
			@PageHeader("Join a campaign", "Pick the campaign your table is playing.")
			<div class="space-y-3">
				for _, c := range campaigns {
					@campaignRow(fmt.Sprintf("/join/%d", c.ID), c)
				}
			</div>
			if len(campaigns) == 0 {
				@empty.Empty(empty.Props{Class: "border"}) {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.Users()
						}
						@empty.Title() {
							No campaigns yet
						}
						@empty.Description() {
							The GM hasn't created a campaign yet. Ask them to make one, then reload this page.
						}
					}
				}
			}
			@adminLink()
		}
	}
}

templ adminLink() {
	<p class="mt-10 text-sm text-muted-foreground">
		GM on another device? <a class="underline" href="/admin/login">Log in as GM</a>
	</p>
}

templ JoinCharacters(l Layout, c sqlc.Campaign, chars []sqlc.Character, err string) {
	@Page(l) {
		@narrow() {
			@PageHeader(c.Name, "Enter your name, then choose your character or make a new one.")
			if err != "" {
				@Notice(err, true, "mb-4")
			}
			// app.js copies the name into each form and remembers it on this device.
			<div class="mb-8 space-y-2">
				@label.Label(label.Props{For: "player-name", Class: "text-base font-semibold"}) {
					Your name <span class="text-destructive" aria-hidden="true">*</span>
				}
				@input.Input(input.Props{ID: "player-name", Placeholder: "So the GM knows who you are", Required: true, Attributes: templ.Attributes{"maxlength": "12", "autocomplete": "nickname", "aria-describedby": "player-name-error"}})
				<p id="player-name-error" class="text-sm text-destructive" hidden>Enter your name so the GM knows who you are.</p>
			</div>
			<h2 class="mb-2 text-base font-semibold">Who are you playing?</h2>
			<div class="space-y-2">
				for _, ch := range chars {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/join/%d/claim/%d", c.ID, ch.ID)) } class="flex min-h-14 items-center justify-between gap-3 rounded-lg border p-3" data-player>
						<input type="hidden" name="player"/>
						<span class="min-w-0 font-medium">{ ch.Name }</span>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
							This is me
						}
					</form>
				}
				if len(chars) == 0 {
					<p class="text-sm text-muted-foreground">No characters yet. Create yours below.</p>
				}
			</div>
			@separator.Separator(separator.Props{Class: "my-6"})
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/join/%d/create", c.ID)) } class="space-y-2" data-player>
				<input type="hidden" name="player"/>
				@label.Label(label.Props{For: "new-name", Class: "text-base font-semibold"}) {
					New character
				}
				<div class="flex gap-2">
					@input.Input(input.Props{ID: "new-name", Name: "name", Placeholder: "Character name", Required: true})
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create
					}
				</div>
				if !c.OpenJoin {
					<p class="text-xs text-muted-foreground">The GM approves new characters in this campaign.</p>
				}
			</form>
			@adminLink()
		}
	}
}

// Waiting is a visitor's join request as they see it.
type Waiting struct {
	Secret string
	Name   string
	State  string // "waiting", "approved", "denied"
}

templ JoinWaiting(l Layout, w Waiting) {
	@Page(l) {
		@narrow() {
			@PageHeader("Waiting for the GM", "Keep this page open.")
			@PendingStatus(w)
		}
	}
}

// PendingStatus is swapped in over the websocket when the GM decides. On
// approval it redeems the request right away.
templ PendingStatus(w Waiting) {
	<div id="pending-status" hx-swap-oob="true" { live(LiveWaiting, w.Secret)... }>
		switch w.State {
			case "approved":
				<p class="flex items-center gap-2">
					@spinner.Spinner(spinner.Props{Class: "size-4"})
					Approved! Opening { w.Name }…
				</p>
				<form hx-post="/requests/complete" hx-trigger="load" hx-swap="none">
					<input type="hidden" name="secret" value={ w.Secret }/>
				</form>
			case "denied":
				<p class="flex items-center gap-2">
					@icon.CircleX(icon.Props{Size: 18, Class: "shrink-0 text-destructive"})
					The GM declined this request.
				</p>
				@button.Button(button.Props{Href: "/join", Variant: button.VariantOutline, Class: "mt-4"}) {
					Start over
				}
			default:
				<p class="flex items-center gap-2">
					@spinner.Spinner(spinner.Props{Class: "size-4 shrink-0"})
					<span>Asked the GM for <strong>{ w.Name }</strong>. This page updates by itself.</span>
				</p>
		}
	</div>
}

templ AdminLogin(l Layout, err string) {
	@Page(l) {
		@narrow() {
			@button.Button(button.Props{Href: "/join", Variant: button.VariantOutline, Size: button.SizeSm, Class: "mb-4"}) {
				@icon.ArrowLeft()
				Back
			}
			@PageHeader("GM login", "For GM devices other than the host PC.")
			<form method="post" action="/admin/login" class="space-y-3">
				if err != "" {
					@Notice(err, true, "")
				}
				<div class="space-y-1">
					@label.Label(label.Props{For: "username"}) {
						Username
					}
					@input.Input(input.Props{ID: "username", Name: "username", Required: true, Attributes: templ.Attributes{"autocomplete": "username"}})
				</div>
				<div class="space-y-1">
					@label.Label(label.Props{For: "password"}) {
						Password
					}
					@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Log in
				}
			</form>
		}
	}
}
