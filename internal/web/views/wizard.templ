package views

import (
	"cmp"
	"fmt"
	"gm-session-manager/internal/compendium"
	"gm-session-manager/internal/dnd5e"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/card"
	"gm-session-manager/internal/web/components/field"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/label"
	"gm-session-manager/internal/web/components/radiogroup"
	"gm-session-manager/internal/web/components/textarea"
	"gm-session-manager/internal/web/utils"
	"net/url"
	"slices"
	"strings"
)

// WizardStep is one step of character creation.
type WizardStep struct {
	Key, Title string
}

// WizardView is one page of the creation wizard.
type WizardView struct {
	CharacterID int64
	Step        string
	Steps       []WizardStep
	// Sheet is the character as it stands, read-only.
	Sheet SheetView
	Error string
	// ErrorFor is the form field Error is about, shown there; "" at the top.
	ErrorFor string
	// Form is the refused form's values, ticked again; nil on a fresh page.
	Form url.Values
	// Options are the compendium's classes, species or backgrounds;
	// Picked is the one being looked at and Choice what it gives.
	Options   []Option
	Picked    string
	Choice    *WizardChoice
	Equipment []EquipmentChoice
	Choices   *CreationChoices
}

// CreationChoices are the picks a level-1 class and a species leave open.
type CreationChoices struct {
	Groups    []ChoiceGroup
	Spells    []Option
	SpellNeed SpellNeed
	// Columns are the class table at level 1, for the spell totals.
	Columns map[string]string
}

// ChoiceGroup asks for up to Count of Options (a lineage, a skill,
// languages, invocations).
type ChoiceGroup struct {
	Key, Title string
	Count      int
	Options    []compendium.NameDesc
	// Sub are the choices an option brings, shown while it is picked.
	Sub map[string][]ChoiceGroup
}

// WizardChoice is what a class, species or background gives.
type WizardChoice struct {
	Slug, Name string
	// Traits are a class's core traits (primary ability, hit die…).
	Traits map[string]string
	// Facts are a species' or background's tagged parts (size, speed,
	// ability scores…), shown as they are.
	Facts []compendium.NameDesc
	// Skills are the skill keys to choose SkillCount of (a class) or that
	// come with it (a background).
	SkillCount int
	Skills     []string
	// Abilities are a background's three abilities for its increases.
	Abilities []string
	Features  []FeaturePreview
}

// FeaturePreview is a feature as the wizard shows it, with what the sheet
// will track for it.
type FeaturePreview struct {
	Name, Desc string
	Effects    []string
}

// EquipmentChoice is a class's or background's starting equipment options.
type EquipmentChoice struct {
	Key, Title string
	Options    []compendium.EquipmentOption
}

func (v WizardView) path(step string) string {
	return fmt.Sprintf("/characters/%d/create/%s", v.CharacterID, step)
}

// done reports whether a step that adds to the sheet was applied.
func (v WizardView) done(step string) bool { return v.Sheet.C.Sheet.SetUp(step) }

templ WizardPage(l Layout, v WizardView) {
	@Page(l) {
		@PageHeader("Create "+v.Sheet.C.Name, "One step at a time. Skip anything you want to fill in later; everything stays editable on the sheet.")
		<nav class="mb-6 flex flex-wrap gap-1.5" aria-label="Steps">
			for i, st := range v.Steps {
				<a
					href={ templ.SafeURL(v.path(st.Key)) }
					class={ "rounded-full border px-3 py-1 text-sm", templ.KV("border-primary bg-primary text-primary-foreground", st.Key == v.Step), templ.KV("text-muted-foreground", st.Key != v.Step) }
					if st.Key == v.Step {
						aria-current="step"
					}
				>
					{ fmt.Sprint(i + 1) }. { st.Title }
					if v.done(st.Key) {
						✓
					}
				</a>
			}
		</nav>
		if v.Error != "" && v.ErrorFor == "" {
			@Notice(v.Error, true, "mb-4")
		}
		switch v.Step {
			case "class", "species", "background":
				@wizardPick(v)
			case "abilities":
				@wizardAbilities(v)
			case "choices":
				@wizardChoices(v)
			case "equipment":
				@wizardEquipment(v)
			case "details":
				@wizardDetails(v)
			case "review":
				@wizardReview(v)
		}
	}
}

// wizardNav are a step form's buttons: Back, Skip (to the next step without
// changing anything) and the form's own submit.
templ wizardNav(v WizardView, submit string) {
	{{ i := slices.IndexFunc(v.Steps, func(s WizardStep) bool { return s.Key == v.Step }) }}
	<div class="flex flex-wrap items-center gap-2 pt-2">
		if i > 0 {
			<a class="text-sm underline" href={ templ.SafeURL(v.path(v.Steps[i-1].Key)) }>Back</a>
		}
		<span class="flex-1"></span>
		if i+1 < len(v.Steps) {
			<a class="text-sm underline" href={ templ.SafeURL(v.path(v.Steps[i+1].Key)) }>Skip</a>
		}
		if submit != "" {
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				{ submit }
			}
		}
	</div>
}

// wizardPick chooses a class, species or background, showing what the one
// picked gives before it is applied.
templ wizardPick(v WizardView) {
	if v.done(v.Step) {
		<p class="mb-4 text-sm">
			Already chosen:
			<strong>
				switch v.Step {
					case "class":
						{ v.Sheet.C.Sheet.ClassSummary() }
					case "species":
						{ v.Sheet.C.Sheet.Species }
					default:
						{ v.Sheet.C.Sheet.Background }
				}
			</strong>.
			Change it on the sheet; level up for more classes.
		</p>
		<form method="post">
			@wizardNav(v, "Next")
		</form>
	} else {
		<form method="get" class="mb-6 flex items-center gap-2" onchange="this.submit()">
			@label.Label(label.Props{For: "pick-trigger"}) {
				{ map[string]string{"class": "Class", "species": "Species", "background": "Background"}[v.Step] }
			}
			@formSelect("pick", "pick", optionItems("Choose…", v.Options, func(o Option) string { return o.Slug }), v.Picked, "", "")
			<noscript>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Show
				}
			</noscript>
		</form>
		if len(v.Options) == 0 {
			<p class="mb-4 text-sm text-muted-foreground">Nothing in the compendium yet. Skip this step and fill it in on the sheet.</p>
		}
		<form method="post" class="space-y-4">
			<input type="hidden" name="pick" value={ v.Picked }/>
			if c := v.Choice; c != nil {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							{ c.Name }
						}
					}
					@card.Content() {
						<div class="space-y-4 text-sm">
							@wizardFacts(c)
							if v.Step == "class" && c.SkillCount > 0 {
								<fieldset { v.fieldErr().describedBy("skill")... }>
									<legend class="font-medium">Choose { fmt.Sprint(c.SkillCount) } skills</legend>
									@v.fieldErr().at("skill")
									<div class="mt-1 grid grid-cols-2 gap-1 sm:grid-cols-3">
										for _, k := range c.Skills {
											@checkField("skill", k, slices.Contains(v.Form["skill"], k)) {
												{ skillName(k) }
											}
										}
									</div>
								</fieldset>
							}
							if v.Step == "background" && len(c.Abilities) == 3 {
								@backgroundAbilities(c, v.Form)
							}
							if len(c.Features) > 0 {
								<div>
									<div class="font-medium">You get</div>
									for _, f := range c.Features {
										<details class="mt-1">
											<summary class="cursor-pointer">
												{ f.Name }
												if len(f.Effects) > 0 {
													<span class="text-xs text-muted-foreground">{ strings.Join(f.Effects, "; ") }</span>
												}
											</summary>
											<div class="mt-1 text-muted-foreground">
												@markdown(f.Desc)
											</div>
										</details>
									}
								</div>
							}
						</div>
					}
				}
			}
			@wizardNav(v, utils.IfElse(v.Choice != nil, "Choose "+choiceName(v.Choice), ""))
		</form>
	}
}

func choiceName(c *WizardChoice) string {
	if c == nil {
		return ""
	}
	return c.Name
}

func skillName(key string) string {
	for _, sk := range dnd5e.Skills {
		if sk.Key == key {
			return sk.Name
		}
	}
	return key
}

// wizardFacts are a class's core traits or a species' or background's
// tagged parts.
templ wizardFacts(c *WizardChoice) {
	<dl class="grid gap-x-4 gap-y-1 sm:grid-cols-[auto_1fr]">
		for _, k := range []string{"Primary Ability", "Hit Point Die", "Saving Throw Proficiencies", "Weapon Proficiencies", "Armor Training", "Tool Proficiencies"} {
			if t := c.Traits[k]; t != "" {
				<dt class="text-muted-foreground">{ k }</dt>
				<dd>{ t }</dd>
			}
		}
		for _, f := range c.Facts {
			<dt class="text-muted-foreground">{ f.Name }</dt>
			<dd>
				@markdown(f.Desc)
			</dd>
		}
	</dl>
}

// backgroundAbilities raises the background's abilities: +2 and +1, or +1
// to all three.
templ backgroundAbilities(c *WizardChoice, form url.Values) {
	{{ items := selectItems(c.Abilities, func(a string) string { return a }, func(a string) string { return dnd5e.AbilityNames[a] }) }}
	{{ three := form.Get("mode") == "three" }}
	<fieldset class="space-y-2">
		<legend class="font-medium">Ability score increases</legend>
		<div class="flex flex-wrap items-center gap-2">
			<label class="flex items-center gap-1"><input type="radio" name="mode" value="two" checked?={ !three }/> +2 to</label>
			@formSelect("", "plus2", items, cmp.Or(form.Get("plus2"), c.Abilities[0]), "", "")
			<span>and +1 to</span>
			@formSelect("", "plus1", items, cmp.Or(form.Get("plus1"), c.Abilities[1]), "", "")
		</div>
		<label class="flex items-center gap-1"><input type="radio" name="mode" value="three" checked?={ three }/> +1 to all three</label>
		<p class="text-xs text-muted-foreground">No score goes above 20. Set your base scores in the previous step first.</p>
	</fieldset>
}

// wizardAbilities sets the six base scores, with the standard array and
// the point-buy cost to help.
templ wizardAbilities(v WizardView) {
	if v.done("background") {
		<p class="mb-4 text-sm">Your background's increases are already added to your scores, so change them on the sheet from now on.</p>
		<form method="post">
			@wizardNav(v, "Next")
		</form>
	} else {
		@abilityForm(v)
	}
}

templ abilityForm(v WizardView) {
	<form method="post" class="space-y-4" data-point-buy>
		<p class="text-sm text-muted-foreground">
			Use the standard array (15, 14, 13, 12, 10, 8), buy points (27 points, scores 8–15), or type what you rolled. Put the highest in your class's primary ability. Background increases come next.
		</p>
		<div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
			for _, a := range dnd5e.Abilities {
				<div class="space-y-1">
					@label.Label(label.Props{For: "score-" + a}) {
						{ dnd5e.AbilityNames[a] }
					}
					@input.Input(input.Props{ID: "score-" + a, Name: a, Type: "number", Value: fmt.Sprint(v.Sheet.C.Sheet.Scores[a]), Class: "text-center", Attributes: templ.Attributes{"min": "3", "max": "20", "required": true}})
				</div>
			}
		</div>
		<div class="flex flex-wrap items-center gap-3 text-sm">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{
				"onclick": "const f = this.form; [15, 14, 13, 12, 10, 8].forEach((n, i) => f.elements[['str','dex','con','int','wis','cha'][i]].value = n); f.dispatchEvent(new Event('input'))",
			}}) {
				Fill in the standard array
			}
			<span class="text-muted-foreground" data-point-cost></span>
		</div>
		@wizardNav(v, "Save scores")
	</form>
}

// wizardChoices asks what the class and species leave open: lineage,
// skills, languages, invocations and spells.
templ wizardChoices(v WizardView) {
	if v.done("choices") {
		<p class="mb-4 text-sm">Your choices are on the sheet already.</p>
		<form method="post">
			@wizardNav(v, "Next")
		</form>
	} else if len(v.Sheet.C.Sheet.Classes) == 0 || v.Sheet.C.Sheet.Species == "" {
		<p class="mb-4 text-sm text-muted-foreground">Choose a class and a species first: what they leave open is asked here.</p>
		@wizardNav(v, "")
	} else {
		<form method="post" class="space-y-4 text-sm">
			if c := v.Choices; c != nil {
				for _, g := range c.Groups {
					@choiceFieldset(g, v.Form, v.fieldErr())
				}
				@spellChecklist(c.Spells, c.Columns, c.SpellNeed, v.Form, v.fieldErr())
			}
			@wizardNav(v, "Save choices")
		</form>
	}
}

// FieldError is a refused form's error and the field it is about.
type FieldError struct{ Key, Msg string }

func (v WizardView) fieldErr() FieldError { return FieldError{Key: v.ErrorFor, Msg: v.Error} }

// DrawsField reports whether the page shows an error at key; the handler shows
// one for a field it does not draw (a crafted post) at the top instead.
func (v WizardView) DrawsField(key string) bool {
	switch key {
	case "skill":
		return v.Step == "class" && v.Choice != nil && v.Choice.SkillCount > 0
	case "spell":
		return v.Choices != nil && len(v.Choices.Spells) > 0
	}
	return v.Choices != nil && drawsGroup(v.Choices.Groups, key)
}

// drawsGroup mirrors choiceFieldset: a group's key, then its options' own groups.
func drawsGroup(groups []ChoiceGroup, key string) bool {
	for _, g := range groups {
		if g.Key == key {
			return true
		}
		for _, o := range g.Options {
			if drawsGroup(g.Sub[o.Name], key) {
				return true
			}
		}
	}
	return false
}

// at shows the error when it is about key; app.js scrolls to it.
templ (fe FieldError) at(key string) {
	if fe.Key == key {
		@field.Error(field.ErrorProps{ID: "error-" + key, Attributes: templ.Attributes{"data-error-for": key}}) {
			{ fe.Msg }
		}
	}
}

// describedBy links a control group to the error at(key) shows; no attribute
// when the error is about another field.
func (fe FieldError) describedBy(key string) templ.Attributes {
	if fe.Key != key {
		return nil
	}
	return templ.Attributes{"aria-describedby": "error-" + key}
}

// radioAttrs labels a single-pick radio group, and marks it invalid when
// it holds the error (aria-invalid is valid on a radiogroup, not a fieldset).
func (fe FieldError) radioAttrs(key, label string) templ.Attributes {
	a := fe.describedBy(key)
	if a == nil {
		a = templ.Attributes{}
	} else {
		a["aria-invalid"] = "true"
	}
	a["aria-label"] = label
	return a
}

// choiceFieldset asks for up to g.Count of its options: radios for one,
// checkboxes for more. An option's own choices follow, hidden until it is
// picked (app.js); outside the radio group, which would take their radios.
// form holds a refused form's picks, ticked again, and fe its error.
templ choiceFieldset(g ChoiceGroup, form url.Values, fe FieldError) {
	<div class="space-y-4">
		@choiceOptions(g, form, fe)
		for _, o := range g.Options {
			if subs := g.Sub[o.Name]; len(subs) > 0 {
				<div class="ml-6 space-y-4" data-show-for={ g.Key + "=" + o.Name } hidden?={ !slices.Contains(form[g.Key], o.Name) }>
					for _, s := range subs {
						@choiceFieldset(s, form, fe)
					}
				</div>
			}
		}
	</div>
}

templ choiceOptions(g ChoiceGroup, form url.Values, fe FieldError) {
	<fieldset class={ "space-y-2 rounded-md border p-3", templ.KV("border-destructive", fe.Key == g.Key) } { fe.describedBy(g.Key)... }>
		<legend class="px-1 font-medium">
			{ g.Title }
			if g.Count > 1 {
				<span class="font-normal text-muted-foreground">(choose { fmt.Sprint(g.Count) })</span>
			}
		</legend>
		@fe.at(g.Key)
		if g.Count == 1 {
			@radiogroup.RadioGroup(radiogroup.Props{Name: g.Key, DefaultValue: form.Get(g.Key), Class: "gap-2", Attributes: fe.radioAttrs(g.Key, g.Title)}) {
				for i, o := range g.Options {
					<div>
						@label.Label(label.Props{For: fmt.Sprintf("%s-%d", g.Key, i), Class: "font-normal"}) {
							@radiogroup.Item(radiogroup.ItemProps{ID: fmt.Sprintf("%s-%d", g.Key, i), Value: o.Name})
							{ o.Name }
						}
						@optionDesc(o.Desc)
					</div>
				}
			}
		} else {
			<div class="grid gap-2 sm:grid-cols-2">
				for _, o := range g.Options {
					<div>
						@checkField(g.Key, o.Name, slices.Contains(form[g.Key], o.Name)) {
							{ o.Name }
						}
						@optionDesc(o.Desc)
					</div>
				}
			</div>
		}
	</fieldset>
}

// optionDesc is an option's text: short ones as they are, long ones folded.
templ optionDesc(desc string) {
	if len(desc) > 200 {
		<details class="ml-6">
			<summary class="cursor-pointer text-xs text-muted-foreground">What it does</summary>
			<div class="mt-1 text-muted-foreground">
				@markdown(desc)
			</div>
		</details>
	} else if desc != "" {
		<div class="ml-6 text-muted-foreground">
			@markdown(desc)
		</div>
	}
}

// wizardEquipment picks one starting equipment option from the class and
// one from the background.
templ wizardEquipment(v WizardView) {
	if v.done("equipment") {
		<p class="mb-4 text-sm">Starting equipment is on the sheet already.</p>
		<form method="post">
			@wizardNav(v, "Next")
		</form>
	} else {
		<form method="post" class="space-y-4 text-sm">
			if len(v.Equipment) == 0 {
				<p class="text-muted-foreground">Choose a class and a background first, or skip and add items on the sheet.</p>
			}
			for _, ec := range v.Equipment {
				<fieldset class="space-y-2 rounded-md border p-3">
					<legend class="px-1 font-medium">{ ec.Title }</legend>
					for i, o := range ec.Options {
						<label class="flex items-start gap-2">
							<input type="radio" name={ "option_" + ec.Key } value={ o.Letter } checked?={ i == 0 } class="mt-1"/>
							<span>
								({ o.Letter })
								for j, it := range o.Items {
									if j > 0 {
										,
									}
									if it.Qty > 1 {
										{ fmt.Sprint(it.Qty) }
									}
									{ it.Name }
								}
								if o.GP > 0 {
									if len(o.Items) > 0 {
										and
									}
									{ fmt.Sprint(o.GP) } GP
								}
							</span>
						</label>
					}
				</fieldset>
			}
			<p class="text-xs text-muted-foreground">Weapons go under attacks and armor is worn right away when the compendium knows them.</p>
			@wizardNav(v, utils.IfElse(len(v.Equipment) > 0, "Take this equipment", ""))
		</form>
	}
}

templ wizardDetails(v WizardView) {
	<form method="post" class="max-w-xl space-y-4">
		<div class="space-y-1">
			@label.Label(label.Props{For: "details-name"}) {
				Name
			}
			@input.Input(input.Props{ID: "details-name", Name: "name", Value: v.Sheet.C.Name, Required: true, Attributes: templ.Attributes{"maxlength": "100"}})
		</div>
		// Species set these when they can; a species of two sizes leaves the pick here.
		<div class="flex flex-wrap gap-4">
			<div class="space-y-1">
				@label.Label(label.Props{For: "details-size-trigger"}) {
					Size
				}
				@formSelect("details-size", "size", sizeItems, cmp.Or(v.Sheet.C.Sheet.Size, "Medium"), "w-40", "")
			</div>
			<div class="flex-1 space-y-1">
				@label.Label(label.Props{For: "details-vision"}) {
					Vision
				}
				@input.Input(input.Props{ID: "details-vision", Name: "vision", Value: v.Sheet.C.Sheet.Vision, Placeholder: "Normal sight, or Darkvision 60 ft", Attributes: templ.Attributes{"maxlength": "200"}})
			</div>
		</div>
		<div class="space-y-1">
			@label.Label(label.Props{For: "details-backstory"}) {
				Backstory
			}
			@textarea.Textarea(textarea.Props{ID: "details-backstory", Name: "backstory", Rows: 8, Value: v.Sheet.C.Sheet.Backstory, Placeholder: "Where they come from, what they want…"})
		</div>
		@wizardNav(v, "Save")
	</form>
}

// wizardReview is the finished character, read-only, with the breakdowns.
templ wizardReview(v WizardView) {
	<div class="space-y-4">
		<p class="text-sm">
			<strong>{ v.Sheet.C.Name }</strong>
			for _, p := range v.Sheet.subtitle() {
				· { p.text }
			}
		</p>
		@vitalsStrip(v.Sheet)
		@statsCard(v.Sheet)
		<div class="grid gap-4 md:grid-cols-2">
			@abilitiesCard(v.Sheet)
			@skillsCard(v.Sheet)
		</div>
		@actionsCard(v.Sheet)
		<div class="grid gap-4 md:grid-cols-2">
			@inventoryCard(v.Sheet)
			@featuresCard(v.Sheet)
		</div>
		<form method="post">
			@wizardNav(v, "Finish and open the sheet")
		</form>
	</div>
}
