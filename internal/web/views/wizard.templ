package views

import (
	"cmp"
	"fmt"
	"gm-session-manager/internal/compendium"
	"gm-session-manager/internal/dnd5e"
	"gm-session-manager/internal/web/components/alert"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/card"
	"gm-session-manager/internal/web/components/checkbox"
	"gm-session-manager/internal/web/components/field"
	"gm-session-manager/internal/web/components/icon"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/label"
	"gm-session-manager/internal/web/components/radiogroup"
	"gm-session-manager/internal/web/components/textarea"
	"gm-session-manager/internal/web/utils"
	"net/url"
	"slices"
	"strings"
)

templ WizardPage(l Layout, v WizardView) {
	@Page(l) {
		@PageHeader("Create "+v.Sheet.C.Name, "One step at a time. Skip anything you want to fill in later; everything stays editable on the sheet.")
		{{ skipped := v.skipped() }}
		<nav class="mb-6 flex flex-wrap gap-1.5" aria-label="Steps">
			for i, st := range v.Steps {
				{{ skip := slices.Contains(skipped, st) }}
				<a
					href={ templ.SafeURL(v.path(st.Key)) }
					class={ "rounded-full border px-3 py-1 text-sm", templ.KV("border-primary bg-primary text-primary-foreground", st.Key == v.Step), templ.KV("text-muted-foreground", st.Key != v.Step), templ.KV("border-dashed", skip) }
					if st.Key == v.Step {
						aria-current="step"
					}
				>
					{ fmt.Sprint(i + 1) }. { st.Title }
					if v.done(st.Key) {
						✓
					} else if skip {
						<span aria-hidden="true">○</span>
						<span class="sr-only">(skipped)</span>
					}
				</a>
			}
		</nav>
		if v.Error != "" {
			@Notice(v.Error, true, "mb-4")
		}
		switch v.Step {
			case StepClass, StepSpecies, StepBackground:
				@wizardPick(v)
			case StepAbilities:
				@wizardAbilities(v)
			case StepChoices:
				@wizardChoices(v)
			case StepEquipment:
				@wizardEquipment(v)
			case StepDetails:
				@wizardDetails(v)
			case StepReview:
				@wizardReview(v)
		}
	}
}

// wizardNav are a step form's buttons: Back, Skip (to the next step without
// changing anything) and the form's own submit.
templ wizardNav(v WizardView, submit string) {
	{{ i := slices.IndexFunc(v.Steps, func(s WizardStep) bool { return s.Key == v.Step }) }}
	<div class="flex flex-wrap items-center gap-2 pt-2">
		if i > 0 {
			<a class="text-sm underline" href={ templ.SafeURL(v.path(v.Steps[i-1].Key)) }>Back</a>
		}
		<span class="flex-1"></span>
		if i+1 < len(v.Steps) {
			<a class="text-sm underline" href={ templ.SafeURL(v.path(v.Steps[i+1].Key)) }>Skip</a>
		}
		if submit != "" {
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				{ submit }
			}
		}
	</div>
}

// wizardMissing stands in for a step's form until the steps it needs are
// done: what they bring is asked here.
templ wizardMissing(v WizardView) {
	<p class="mb-4 text-sm text-muted-foreground">
		{ "Choose these first, since what they leave open is asked here: " }
		@stepLinks(v, v.Missing, ".")
	</p>
	@wizardNav(v, "")
}

// stepLinks links each step, "A, B" then end, with no space before the
// punctuation (templ spaces elements on separate lines).
templ stepLinks(v WizardView, steps []WizardStep, end string) {
	for i, st := range steps {
		<a class="underline" href={ templ.SafeURL(v.path(st.Key)) }>{ st.Title }</a>{ utils.IfElse(i+1 < len(steps), ", ", end) }
	}
}

// wizardDone is a step already applied: Next, and Change while the wizard
// still holds the character from before it.
templ wizardDone(v WizardView, msg string) {
	<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
		{{ _, redo := v.Sheet.C.Sheet.SetupSnapshots[v.Step] }}
		<p class="min-w-0 grow basis-48">
			{ msg }
			if !redo {
				{ " Change it on the sheet from now on." }
			}
		</p>
		if redo {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{
				"hx-post":    v.path(v.Step) + "/change",
				"hx-confirm": "Redo this step? The character goes back to how it was before it, so the steps saved after it are undone too.",
			}}) {
				@icon.Undo2()
				Change
			}
		}
	</div>
	<form method="post">
		@wizardNav(v, "Next")
	</form>
}

// wizardPick chooses a class, species or background, showing what the one
// picked gives before it is applied.
templ wizardPick(v WizardView) {
	if v.done(v.Step) {
		{{ s := v.Sheet.C.Sheet }}
		@wizardDone(v, "Already chosen: "+map[string]string{StepClass: s.ClassSummary() + " (level up for more classes)", StepSpecies: s.Species, StepBackground: s.Background}[v.Step]+".")
	} else {
		<form method="get" class="mb-6 flex flex-wrap items-center gap-2" onchange="this.submit()">
			@label.Label(label.Props{For: "pick-trigger"}) {
				{ map[string]string{StepClass: "Class", StepSpecies: "Species", StepBackground: "Background"}[v.Step] }
			}
			@formSelect("pick", "pick", optionItems("Choose…", v.Options, func(o Option) string { return o.Slug }), v.Picked, "", "")
			if len(v.Variants) > 0 {
				@label.Label(label.Props{For: "variant-trigger"}) {
					Variant
				}
				@formSelect("variant", "variant", optionItems("Standard", v.Variants, func(o Option) string { return o.Slug }), v.Variant, "", "")
			}
			<noscript>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Show
				}
			</noscript>
		</form>
		if len(v.Options) == 0 {
			<p class="mb-4 text-sm text-muted-foreground">Nothing in the compendium yet. Skip this step and fill it in on the sheet.</p>
		}
		<form method="post" class="space-y-4">
			<input type="hidden" name="pick" value={ utils.IfElse(v.Variant != "", v.Variant, v.Picked) }/>
			if c := v.Choice; c != nil {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							{ c.Name }
						}
					}
					@card.Content() {
						<div class="space-y-4 text-sm">
							@wizardFacts(c)
							if p := c.SkillPick; p != nil {
								<fieldset { v.fieldErr().describedBy(FieldSkill)... } data-max-checked={ fmt.Sprint(p.Count) }>
									<legend class="font-medium">
										{ utils.IfElse(v.Step == StepClass, "Skills", "Class skills") }
										<span class="font-normal text-muted-foreground">({ Choose(p.Count-len(p.Picked), len(p.Picked)+len(p.Known) > 0) })</span>
									</legend>
									if v.Step == StepBackground {
										<p class="text-muted-foreground">This background gives a skill you picked with your class: pick another class skill.</p>
									}
									@v.fieldErr().at(FieldSkill)
									<div class="mt-1 grid grid-cols-2 gap-1 sm:grid-cols-3">
										for _, k := range p.Known {
											@label.Label(label.Props{Class: "font-normal text-muted-foreground"}) {
												@checkbox.Checkbox(checkbox.Props{DefaultChecked: true, Disabled: true})
												{ skillName(k) } (known)
											}
										}
										for _, k := range p.Options {
											@checkField("skill", k, slices.Contains(utils.IfElse(v.Form != nil, v.Form["skill"], p.Picked), k)) {
												{ skillName(k) }
											}
										}
									</div>
								</fieldset>
							}
							if len(c.Features) > 0 {
								<div>
									<div class="font-medium">You get</div>
									for _, f := range c.Features {
										<details class="mt-1">
											<summary class="cursor-pointer">
												{ f.Name }
												if len(f.Effects) > 0 {
													<span class="text-xs text-muted-foreground">{ strings.Join(f.Effects, "; ") }</span>
												}
											</summary>
											<div class="mt-1 text-muted-foreground">
												@markdown(f.Desc)
											</div>
										</details>
									}
								</div>
							}
						</div>
					}
				}
			}
			@wizardNav(v, utils.IfElse(v.Choice != nil, "Choose "+choiceName(v.Choice), ""))
		</form>
	}
}

// wizardFacts are a class's core traits or a species' or background's
// tagged parts.
templ wizardFacts(c *WizardChoice) {
	<dl class="grid gap-x-4 gap-y-1 sm:grid-cols-[auto_1fr]">
		for _, k := range []string{compendium.TraitPrimaryAbility, compendium.TraitHitPointDie, compendium.TraitSavingThrows, compendium.TraitWeaponProficiencies, compendium.TraitArmorTraining, compendium.TraitToolProficiencies} {
			if t := c.Traits[k]; t != "" {
				<dt class="text-muted-foreground">{ k }</dt>
				<dd>{ t }</dd>
			}
		}
		for _, f := range c.Facts {
			<dt class="text-muted-foreground">{ f.Name }</dt>
			<dd>
				@markdown(f.Desc)
			</dd>
		}
	</dl>
}

// backgroundAbilities raises the background's abilities: +2 and +1, or +1
// to all three.
templ backgroundAbilities(c *WizardChoice, form url.Values, fe FieldErrors) {
	{{ items := selectItems(c.Abilities, func(a string) string { return a }, func(a string) string { return dnd5e.AbilityNames[a] }) }}
	{{ three := form.Get("mode") == "three" }}
	<fieldset class={ "space-y-2 rounded-md border p-3", templ.KV("border-destructive", fe[FieldMode] != "") } { fe.describedBy(FieldMode)... }>
		<legend class="font-medium">{ c.Name }: ability score increases</legend>
		@fe.at(FieldMode)
		@radiogroup.RadioGroup(radiogroup.Props{Name: "mode", DefaultValue: utils.IfElse(three, "three", "two"), Class: "gap-2", Attributes: templ.Attributes{"aria-label": "Ability score increases"}}) {
			<div class="flex flex-wrap items-center gap-2">
				@label.Label(label.Props{For: "mode-two", Class: "font-normal"}) {
					@radiogroup.Item(radiogroup.ItemProps{ID: "mode-two", Value: "two"})
					+2 to
				}
				@formSelect("", "plus2", items, cmp.Or(form.Get("plus2"), c.Abilities[0]), "", "")
				<span>and +1 to</span>
				@formSelect("", "plus1", items, cmp.Or(form.Get("plus1"), c.Abilities[1]), "", "")
			</div>
			@label.Label(label.Props{For: "mode-three", Class: "font-normal"}) {
				@radiogroup.Item(radiogroup.ItemProps{ID: "mode-three", Value: "three"})
				+1 to all three
			}
		}
		<p class="text-xs text-muted-foreground">Added to the scores above; no score goes above 20.</p>
	</fieldset>
}

// wizardAbilities sets the six base scores, with the standard array and
// the point-buy cost to help.
templ wizardAbilities(v WizardView) {
	if v.LegacyBackground {
		@wizardDone(v, "Your background's increases are already added to your scores.")
	} else if v.done(StepAbilities) {
		@wizardDone(v, "Your ability scores are on the sheet already.")
	} else if len(v.Missing) > 0 {
		@wizardMissing(v)
	} else {
		@abilityForm(v)
	}
}

templ abilityForm(v WizardView) {
	<form method="post" class="space-y-4" data-point-buy>
		<p class="text-sm text-muted-foreground">
			Use the standard array (15, 14, 13, 12, 10, 8), buy points (27 points, scores 8–15), or type what you rolled. Put the highest in your class's primary ability.
		</p>
		<div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
			for _, a := range dnd5e.Abilities {
				<div class="space-y-1">
					@label.Label(label.Props{For: "score-" + a}) {
						{ dnd5e.AbilityNames[a] }
					}
					@input.Input(input.Props{ID: "score-" + a, Name: a, Type: "number", Value: cmp.Or(v.Form.Get(a), fmt.Sprint(v.Sheet.C.Sheet.Scores[a])), Class: "text-center", Attributes: v.Errors.inputAttrs(a, templ.Attributes{"min": "3", "max": "20", "required": true})})
					@v.Errors.at(a)
				</div>
			}
		</div>
		<div class="flex flex-wrap items-center gap-3 text-sm">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{
				"onclick": templ.JSUnsafeFuncCall("const f = this.form; [15, 14, 13, 12, 10, 8].forEach((n, i) => f.elements[['str','dex','con','int','wis','cha'][i]].value = n); f.dispatchEvent(new Event('input', { bubbles: true }))"),
			}}) {
				Fill in the standard array
			}
			<span class="text-muted-foreground" data-point-cost></span>
		</div>
		if v.Choice != nil {
			@backgroundAbilities(v.Choice, v.Form, v.fieldErr())
		}
		@wizardNav(v, "Save scores")
	</form>
}

// wizardChoices asks what the class and species leave open: lineage,
// skills, languages, invocations and spells.
templ wizardChoices(v WizardView) {
	if v.done(StepChoices) {
		@wizardDone(v, "Your choices are on the sheet already.")
	} else if len(v.Missing) > 0 {
		@wizardMissing(v)
	} else {
		<form method="post" class="space-y-4 text-sm">
			if c := v.Choices; c != nil {
				for _, g := range c.Groups {
					@choiceFieldset(g, v.Form, v.fieldErr())
				}
				@spellChecklist(c.Spells, c.Columns, c.SpellNeed, v.Form, v.fieldErr())
			}
			@wizardNav(v, "Save choices")
		</form>
	}
}

// at shows the error when it is about key; app.js scrolls to it.
templ (fe FieldErrors) at(key string) {
	if msg := fe[key]; msg != "" {
		@field.Error(field.ErrorProps{ID: "error-" + key, Attributes: templ.Attributes{"data-error-for": key}}) {
			{ msg }
		}
	}
}

// choiceFieldset asks for up to g.Count of its options: radios for one,
// checkboxes for more. An option's own choices follow, hidden until it is
// picked (app.js); outside the radio group, which would take their radios.
// form holds a refused form's picks, ticked again, and fe its error.
templ choiceFieldset(g ChoiceGroup, form url.Values, fe FieldErrors) {
	<div class="space-y-4">
		@choiceOptions(g, form, fe)
		for _, o := range g.Options {
			if subs := g.Sub[o.Name]; len(subs) > 0 {
				<div class="ml-6 space-y-4" data-show-for={ g.Key + "=" + o.Name } hidden?={ !slices.Contains(form[g.Key], o.Name) }>
					for _, s := range subs {
						@choiceFieldset(s, form, fe)
					}
				</div>
			}
		}
	</div>
}

templ choiceOptions(g ChoiceGroup, form url.Values, fe FieldErrors) {
	<fieldset
		class={ "space-y-2 rounded-md border p-3", templ.KV("border-destructive", fe[g.Key] != "") }
		{ fe.describedBy(g.Key)... }
		if g.Count > 1 {
			data-max-checked={ fmt.Sprint(g.Count) }
		}
	>
		<legend class="px-1 font-medium">
			{ g.Title }
			if g.Count > 0 {
				<span class="font-normal text-muted-foreground">({ Choose(g.Count, len(g.Known) > 0) })</span>
			}
		</legend>
		@fe.at(g.Key)
		if g.Count == 1 {
			@radiogroup.RadioGroup(radiogroup.Props{Name: g.Key, DefaultValue: form.Get(g.Key), Class: utils.CN("gap-2", optionsGrid(g.Options, "")), Attributes: fe.radioAttrs(g.Key, g.Title)}) {
				for i, o := range g.Options {
					<div>
						@label.Label(label.Props{For: fmt.Sprintf("%s-%d", g.Key, i), Class: "font-normal"}) {
							@radiogroup.Item(radiogroup.ItemProps{ID: fmt.Sprintf("%s-%d", g.Key, i), Value: o.Name})
							{ o.Name }
						}
						@optionDesc(o.Desc)
					</div>
				}
			}
		} else {
			<div class={ "grid gap-2", optionsGrid(g.Options, "sm:grid-cols-2") }>
				for _, k := range g.Known {
					@label.Label(label.Props{Class: "font-normal text-muted-foreground"}) {
						@checkbox.Checkbox(checkbox.Props{DefaultChecked: true, Disabled: true})
						{ k } { utils.IfElse(k == "Common", "(every character knows it)", "(known)") }
					}
				}
				for _, o := range g.Options {
					<div>
						@checkField(g.Key, o.Name, slices.Contains(form[g.Key], o.Name)) {
							{ o.Name }
						}
						@optionDesc(o.Desc)
					</div>
				}
			</div>
		}
	</fieldset>
}

// optionDesc is an option's text: short ones as they are, long ones folded.
templ optionDesc(desc string) {
	if len(desc) > 200 {
		<details class="ml-6">
			<summary class="cursor-pointer text-xs text-muted-foreground">What it does</summary>
			<div class="mt-1 text-muted-foreground">
				@markdown(desc)
			</div>
		</details>
	} else if desc != "" {
		<div class="ml-6 text-muted-foreground">
			@markdown(desc)
		</div>
	}
}

// wizardEquipment picks one starting equipment option from the class and
// one from the background.
templ wizardEquipment(v WizardView) {
	if v.done(StepEquipment) {
		@wizardDone(v, "Starting equipment is on the sheet already.")
	} else if len(v.Missing) > 0 {
		@wizardMissing(v)
	} else {
		<form method="post" class="space-y-4 text-sm">
			if len(v.Equipment) == 0 {
				<p class="text-muted-foreground">The compendium lists no starting equipment for these; skip and add items on the sheet.</p>
			}
			for _, ec := range v.Equipment {
				<fieldset class="space-y-2 rounded-md border p-3">
					<legend class="px-1 font-medium">{ ec.Title }</legend>
					@radiogroup.RadioGroup(radiogroup.Props{Name: "option_" + ec.Key, DefaultValue: ec.Options[0].Letter, Class: "gap-2", Attributes: templ.Attributes{"aria-label": ec.Title}}) {
						for _, o := range ec.Options {
							@label.Label(label.Props{For: "option-" + ec.Key + "-" + o.Letter, Class: "items-start font-normal"}) {
								@radiogroup.Item(radiogroup.ItemProps{ID: "option-" + ec.Key + "-" + o.Letter, Value: o.Letter, Class: "mt-0.5"})
								<span>{ optionText(o) }</span>
							}
						}
					}
				</fieldset>
			}
			<p class="text-xs text-muted-foreground">Weapons go under attacks and armor is worn right away when the compendium knows them.</p>
			@wizardNav(v, utils.IfElse(len(v.Equipment) > 0, "Take this equipment", ""))
		</form>
	}
}

// wizardDetails shows what was typed after a refusal, not the saved sheet.
templ wizardDetails(v WizardView) {
	{{ typed := func(key, saved string) string { return utils.IfElse(v.Form != nil, v.Form.Get(key), saved) } }}
	<form method="post" class="max-w-xl space-y-4">
		<div class="space-y-1">
			@label.Label(label.Props{For: "details-name"}) {
				Name
			}
			@input.Input(input.Props{ID: "details-name", Name: "name", Value: typed("name", v.Sheet.C.Name), Required: true, Attributes: v.Errors.inputAttrs(FieldName, templ.Attributes{"maxlength": "100"})})
			@v.Errors.at(FieldName)
		</div>
		// Species set these when they can; a species of two sizes leaves the pick here.
		<div class="flex flex-wrap gap-4">
			<div class="space-y-1" role="group" aria-label="Size" { v.Errors.describedBy(FieldSize)... }>
				@label.Label(label.Props{For: "details-size-trigger"}) {
					Size
				}
				@formSelect("details-size", "size", sizeItems, cmp.Or(typed("size", v.Sheet.C.Sheet.Size), "Medium"), "w-40", "")
				@v.Errors.at(FieldSize)
			</div>
			<div class="flex-1 space-y-1">
				@label.Label(label.Props{For: "details-vision"}) {
					Vision
				}
				@input.Input(input.Props{ID: "details-vision", Name: "vision", Value: typed("vision", v.Sheet.C.Sheet.Vision), Placeholder: "Normal sight, or Darkvision 60 ft", Attributes: v.Errors.inputAttrs(FieldVision, templ.Attributes{"maxlength": "200"})})
				@v.Errors.at(FieldVision)
			</div>
		</div>
		<div class="space-y-1">
			@label.Label(label.Props{For: "details-backstory"}) {
				Backstory
			}
			@textarea.Textarea(textarea.Props{ID: "details-backstory", Name: "backstory", Rows: 8, Value: typed("backstory", v.Sheet.C.Sheet.Backstory), Placeholder: "Where they come from, what they want…", Attributes: v.Errors.inputAttrs(FieldBackstory, nil)})
			@v.Errors.at(FieldBackstory)
		</div>
		@wizardNav(v, "Save")
	</form>
}

// wizardReview is the finished character, read-only, with the breakdowns.
templ wizardReview(v WizardView) {
	<div class="space-y-4">
		if skipped := v.skipped(); len(skipped) > 0 && !v.done(StepReview) {
			@alert.Alert() {
				@icon.CircleDashed()
				@alert.Title() {
					Not done yet
				}
				@alert.Description() {
					<p>
						@stepLinks(v, skipped, ". You can finish anyway and fill these in on the sheet.")
					</p>
				}
			}
		}
		<p class="text-sm">
			<strong>{ v.Sheet.C.Name }</strong>
			for _, p := range v.Sheet.subtitle() {
				· { p.text }
			}
		</p>
		@vitalsStrip(v.Sheet)
		@statsCard(v.Sheet)
		<div class="grid gap-4 md:grid-cols-2">
			@abilitiesCard(v.Sheet)
			@skillsCard(v.Sheet)
		</div>
		@actionsCard(v.Sheet)
		<div class="grid gap-4 md:grid-cols-2">
			@inventoryCard(v.Sheet)
			@featuresCard(v.Sheet)
		</div>
		<form method="post">
			@wizardNav(v, "Finish and open the sheet")
		</form>
	</div>
}
