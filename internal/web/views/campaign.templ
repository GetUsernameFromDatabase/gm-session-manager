package views

import (
	"fmt"
	"gm-session-manager/internal/db/sqlc"
	"gm-session-manager/internal/route"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/icon"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/utils"
)

templ CampaignOverview(l Layout, r Roster, j JoinInfo, s CampaignSourcesView) {
	@Page(l) {
		<div class="mb-6">
			<div class="flex items-center gap-2">
				<form class="min-w-0 flex-1" hx-post={ route.Path(route.CampaignRename, r.Campaign.ID) } hx-trigger="change, submit">
					@input.Input(input.Props{Name: "name", Value: r.Campaign.Name, Required: true, Class: "h-auto min-w-0 border-transparent px-1 text-2xl font-semibold md:text-2xl dark:bg-transparent", Attributes: templ.Attributes{"aria-label": "Campaign name", "maxlength": "100", "autocomplete": "off"}})
				</form>
				@moreMenu("campaign-menu", "More actions") {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "w-full justify-start", Href: route.Path(route.CampaignExport, r.Campaign.ID), Attributes: templ.Attributes{"data-menu-item": ""}}) {
						@icon.Download()
						Export campaign (zip)
					}
					@menuDelete("Delete campaign", route.Path(route.CampaignDelete, r.Campaign.ID), "Delete "+r.Campaign.Name+" forever, with all its characters, notes, combat and images? Its players are logged out. This cannot be undone.")
				}
			</div>
		</div>
		<div class="grid gap-6 md:grid-cols-[1fr_20rem]">
			@CampaignRoster(r)
			<div class="space-y-4">
				@joinPanel(j)
				@CampaignSourcesLive(s)
			</div>
		</div>
		@TakeHomeDialog()
	}
}

// PendingRequests is the GM's approval popup on every page, for every
// campaign. It hangs from the top so a new request lands below the others
// instead of moving the button under the GM's cursor.
templ PendingRequests(groups []PendingGroup) {
	<div id="pending-requests" hx-swap-oob="true" class="fixed top-16 right-4 z-50 max-h-[calc(100vh-5rem)] w-80 space-y-2 overflow-y-auto" { live(LiveRequests, 0)... }>
		for _, g := range groups {
			if len(g.Requests) > 1 {
				// Decides only the requests shown, never one that arrived since.
				<form class="flex items-center gap-2 rounded-lg border bg-popover px-3 py-2 text-sm text-popover-foreground shadow-lg">
					for _, p := range g.Requests {
						<input type="hidden" name="id" value={ p.ID }/>
					}
					<span class="min-w-0 flex-1 truncate">
						{ fmt.Sprintf("%d requests for ", len(g.Requests)) }
						@campaignLink(g)
					</span>
					@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": route.Path(route.CampaignRequestsDecision, g.CampaignID, "approve"), "aria-label": fmt.Sprintf("Approve all %d requests for %s", len(g.Requests), g.CampaignName)}}) {
						Approve
					}
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": route.Path(route.CampaignRequestsDecision, g.CampaignID, "deny"), "aria-label": fmt.Sprintf("Deny all %d requests for %s", len(g.Requests), g.CampaignName)}}) {
						Deny
					}
				</form>
			}
			for _, p := range g.Requests {
				<div class="rounded-lg border bg-popover p-4 text-popover-foreground shadow-lg" role="alertdialog">
					<p class="font-medium">
						if p.Claim {
							{ p.Player } wants to play { p.Name }
						} else {
							{ p.Player } wants to create { p.Name }
						}
					</p>
					// The bar above names the campaign when there are several.
					if len(g.Requests) == 1 {
						<p class="text-sm">
							@campaignLink(g)
						</p>
					}
					<p class="mb-3 flex items-center gap-1 text-xs text-muted-foreground">
						if p.Phone {
							@icon.Smartphone(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"role": "img", "aria-label": "phone"}})
						} else {
							@icon.Monitor(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"role": "img", "aria-label": "computer"}})
						}
						{ p.Device }
						if p.Host != "" {
							· { p.Host }
						}
					</p>
					<div class="flex gap-2">
						@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": route.Path(route.CampaignRequestDecision, g.CampaignID, p.ID, "approve")}}) {
							Approve
						}
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": route.Path(route.CampaignRequestDecision, g.CampaignID, p.ID, "deny")}}) {
							Deny
						}
					</div>
				</div>
			}
		}
	</div>
}

// campaignLink opens a request's campaign in a new tab, leaving the GM's page.
templ campaignLink(g PendingGroup) {
	<a class="underline" href={ templ.SafeURL(route.Path(route.Campaign, g.CampaignID)) } target="_blank" rel="noopener">{ g.CampaignName }</a>
}

templ CampaignRoster(r Roster) {
	<section id="campaign-roster" hx-swap-oob="true" { live(LiveRoster, r.Campaign.ID)... }>
		<div class="mb-3 flex items-center justify-between">
			<h2 class="text-lg font-semibold">Characters</h2>
			@button.Button(button.Props{
				Variant:    utils.IfElse(r.Campaign.OpenJoin, button.VariantDefault, button.VariantOutline),
				Size:       button.SizeXs,
				Attributes: templ.Attributes{"hx-post": route.Path(route.CampaignOpenJoin, r.Campaign.ID), "title": "When open, new characters are created without your approval", "aria-pressed": fmt.Sprint(r.Campaign.OpenJoin)},
			}) {
				Open join: { utils.IfElse(r.Campaign.OpenJoin, "on", "off") }
			}
		</div>
		<div class="space-y-3">
			for _, rc := range r.Characters {
				@rosterCard(r, rc)
			}
			if len(r.Characters) == 0 {
				<p class="text-sm text-muted-foreground">No characters yet. Players create them when they join.</p>
			}
		</div>
		if len(r.Deleted) > 0 {
			<h3 class="mt-6 mb-2 text-sm font-semibold">Deleted characters</h3>
			<ul class="space-y-2 text-sm">
				for _, ch := range r.Deleted {
					<li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-dashed p-2">
						<span>
							{ ch.Name }
							<span class="text-xs text-muted-foreground">deleted @localTime(ch.DeletedAt.Time)</span>
						</span>
						<span class="flex flex-wrap gap-2">
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": route.Path(route.CharacterRestore, ch.ID)}}) {
								Restore
							}
							<a class="text-xs underline" href={ templ.SafeURL(route.Path(route.CharacterDownload, ch.ID)) } download>Download</a>
							@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantDestructive, Attributes: templ.Attributes{
								"hx-post": route.Path(route.CharacterDelete, ch.ID), "hx-confirm": "Delete " + ch.Name + " forever, with their notes? This cannot be undone.",
							}}) {
								Delete forever
							}
						</span>
					</li>
				}
			</ul>
		}
		<form
			class="group/busy mt-6 flex flex-wrap items-center gap-2 text-sm"
			data-busy
			hx-post={ route.Path(route.CampaignImportCharacter, r.Campaign.ID) }
			hx-encoding="multipart/form-data"
			hx-on::after-request="if (event.detail.successful) this.reset()"
		>
			<label for="character-file" class="text-muted-foreground">Import a character file</label>
			@input.Input(input.Props{ID: "character-file", Name: "file", Type: "file", Required: true, Class: "w-auto", Attributes: templ.Attributes{"accept": ".json,application/json"}})
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Variant: button.VariantOutline}) {
				Import
			}
			@busyIndicator("Importing…")
		</form>
	</section>
}

// deviceRow names a device, and an offline one also when it was last seen,
// the GM's cue for which to kick.
templ deviceRow(d Device) {
	<li class="flex items-center justify-between gap-2">
		<span class="flex min-w-0 items-start gap-2">
			<span class="mt-1.5 inline-block size-2 shrink-0 rounded-full bg-muted-foreground/40 data-[online=true]:bg-green-500" data-online={ fmt.Sprint(d.Online) }></span>
			<span class="flex min-w-0 flex-col">
				<span class="truncate">{ deviceLabel(d) }</span>
				if !d.Online {
					<span class="text-xs text-muted-foreground">
						{ "seen " }
						@agoTime(d.LastSeen)
					</span>
				}
			</span>
		</span>
		@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantDestructive, Attributes: templ.Attributes{
			"hx-post": route.Path(route.SessionKick, d.SessionID), "hx-confirm": "Kick this device? It can ask to join again.",
		}}) {
			Kick
		}
	</li>
}

templ rosterCard(r Roster, rc RosterCharacter) {
	<div class="rounded-lg border p-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<span class="flex min-w-0 flex-wrap items-center gap-2">
				<a class="font-medium underline-offset-2 hover:underline" href={ templ.SafeURL(route.Path(route.Character, rc.Character.ID)) }>{ rc.Character.Name }</a>
				if !rc.TakenHome.IsZero() {
					@takenHomeBadge(rc.TakenHome)
				}
			</span>
			<span class="text-sm" { bind(fmt.Sprintf("text=ch.%d.hp", rc.Character.ID))... }>{ rosterHP(rc) }</span>
		</div>
		<ul class="mt-2 space-y-1 text-sm">
			for _, d := range rc.Online() {
				@deviceRow(d)
			}
			if off := rc.Offline(); len(off) > 0 {
				<li>
					<details id={ fmt.Sprintf("offline-%d", rc.Character.ID) } data-keep-open>
						<summary class="cursor-pointer text-muted-foreground">{ Plural(len(off), "offline device") }</summary>
						<ul class="mt-1 space-y-1 pl-4">
							for _, d := range off {
								@deviceRow(d)
							}
						</ul>
					</details>
				</li>
			}
			if len(rc.Devices) == 0 {
				<li class="text-muted-foreground">No devices logged in</li>
			}
		</ul>
		<details class="mt-2 text-sm">
			<summary class="cursor-pointer text-muted-foreground">More</summary>
			<div class="mt-2 flex flex-wrap items-center gap-2">
				if len(r.OtherCampaigns) > 0 {
					<form class="flex items-center gap-2" hx-post={ route.Path(route.CharacterCopy, rc.Character.ID) }>
						@formSelect("", "campaign_id", selectItems(r.OtherCampaigns, func(c sqlc.Campaign) string { return fmt.Sprint(c.ID) }, func(c sqlc.Campaign) string { return c.Name }), "", "h-7", "")
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Variant: button.VariantOutline}) {
							Copy to campaign
						}
					</form>
				}
				@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Attributes: takeHomeLoad(rc.Character.ID)}) {
					@icon.House()
					Take home…
				}
				@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantDestructive, Attributes: templ.Attributes{
					"hx-post": route.Path(route.CharacterRemove, rc.Character.ID), "hx-confirm": "Delete " + rc.Character.Name + " and log out its devices? You can restore it afterwards.",
				}}) {
					Delete character
				}
			</div>
		</details>
	</div>
}
