package views

import (
	"fmt"
	"gm-session-manager/internal/dnd5e"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/card"
	"gm-session-manager/internal/web/components/dialog"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/label"
	"net/url"
	"slices"
	"strings"
)

templ LevelUpPage(l Layout, v LevelUpView) {
	@Page(l) {
		@PageHeader("Level up "+v.Name, fmt.Sprintf("Currently level %d. Structured parts are filled in for you; you can still change anything afterwards with commands.", v.Level))
		if v.Error != "" {
			@Notice(v.Error, true, "mb-4")
		}
		<form method="get" class="mb-6 flex items-center gap-2" onchange="this.submit()">
			@label.Label(label.Props{For: "class-trigger"}) {
				Class
			}
			@formSelect("class", "class", optionItems("Choose a class…", v.Classes, func(o Option) string { return o.Slug }), v.Selected, "", "")
			<noscript>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Show
				}
			</noscript>
		</form>
		if len(v.Classes) == 0 {
			<p class="text-muted-foreground">No classes in the compendium yet. Ask the GM to import the SRD (see README), or add features by hand with commands.</p>
		}
		if v.Plan != nil {
			@levelUpForm(v, *v.Plan)
		}
	}
}

templ levelUpForm(v LevelUpView, p dnd5e.LevelUpPlan) {
	<form method="post" class="group/busy space-y-4" data-busy>
		@busyIndicator("Levelling up…")
		<input type="hidden" name="class" value={ p.Class.Slug }/>
		// The level this form takes: a second submit, from here or another device, is refused.
		<input type="hidden" name="level" value={ fmt.Sprint(p.NewLevel) }/>
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ p.Class.Name } { fmt.Sprint(p.ClassLevel) } (character level { fmt.Sprint(p.NewLevel) })
				}
			}
			@card.Content() {
				<div class="space-y-4 text-sm">
					for _, w := range p.Warnings {
						<p class="rounded-md border border-amber-500/50 bg-amber-500/10 px-3 py-2 text-amber-700 dark:text-amber-300" role="alert">{ w } You can still take the level.</p>
					}
					<div>
						<div class="font-medium">What changes</div>
						<ul class="mt-1 list-disc space-y-0.5 pl-5">
							<li>Max hit points +{ fmt.Sprint(p.AverageHP) } (fixed; or your roll below)</li>
							if pb := dnd5e.ProficiencyAt(p.NewLevel); pb != v.Sheet.ProficiencyBonus() {
								<li>Proficiency bonus { dnd5e.Signed(v.Sheet.ProficiencyBonus()) } → { dnd5e.Signed(pb) }</li>
							}
							if before := slotMaxima(v.Sheet); before != p.Slots {
								<li>Spell slots { slotSummary(before) } → { slotSummary(p.Slots) }</li>
							}
							if p.Pact != v.Sheet.Pact.Max || p.PactLevel != v.Sheet.PactLevel {
								<li>Pact slots { fmt.Sprint(p.Pact) } at level { fmt.Sprint(p.PactLevel) }</li>
							}
							for _, f := range p.Features {
								<li>
									New feature: { f.Name }
									if fx := dnd5e.ParseEffects(f.Name, f.Description, p.Class.Table, p.Class.Name).Summary(); len(fx) > 0 {
										<span class="text-muted-foreground">({ strings.Join(fx, "; ") })</span>
									}
								</li>
							}
							for _, sp := range v.LineageSpells {
								<li>{ v.Sheet.Species } spell: { sp.Name } (always prepared, once free per Long Rest)</li>
							}
							if p.ASI {
								<li>Ability Score Improvement or a feat</li>
							}
							if p.NeedsSubclass {
								<li>Choose a subclass</li>
							}
							if p.IsNewClass && v.Level > 0 {
								<li>New class: { p.Class.Name } (no new saving throw proficiencies)</li>
							}
						</ul>
					</div>
					<div>
						<div class="font-medium">Hit points</div>
						if v.Level == 0 {
							<p>First level: maximum hit die (d{ fmt.Sprint(p.Class.HitDie) }) plus Constitution: <strong>+{ fmt.Sprint(p.AverageHP) }</strong>.</p>
						} else {
							<p>Take the fixed <strong>+{ fmt.Sprint(p.AverageHP) }</strong>, or enter what you rolled on the d{ fmt.Sprint(p.Class.HitDie) } (Constitution is added for you).</p>
							@input.Input(input.Props{Name: "hp_roll", Type: "number", Class: "mt-1 w-28", Placeholder: "roll", Value: v.Form.Get("hp_roll"), Attributes: templ.Attributes{"min": "1", "max": fmt.Sprint(p.Class.HitDie)}})
						}
					</div>
					<div>
						<div class="font-medium">Spell slots after this level</div>
						<p>
							// A pure pact caster has no "none" to report.
							if p.Pact == 0 || p.Slots != ([9]int{}) {
								{ slotSummary(p.Slots) }
								if p.Pact > 0 {
									{ " · " }
								}
							}
							if p.Pact > 0 {
								Pact { fmt.Sprint(p.Pact) } at level { fmt.Sprint(p.PactLevel) }
							}
						</p>
					</div>
					if len(p.Columns) > 0 {
						<div>
							<div class="font-medium">Class table</div>
							<ul>
								for _, k := range sortedColumns(p.Columns) {
									<li>{ k }: { p.Columns[k] }</li>
								}
							</ul>
						</div>
					}
					if p.NeedsSubclass && len(v.Subclasses) > 0 {
						<div>
							@label.Label(label.Props{For: "subclass-trigger", Class: "mb-1"}) {
								Subclass
							}
							@SubclassPicker(v.Subclasses, v.SubclassPanels, v.Form.Get("subclass"), p.NewLevel)
						</div>
					}
					if p.ASI {
						<fieldset class={ "space-y-2 rounded-md border p-3", templ.KV("border-destructive", v.Errors[FieldASI] != "") } { v.fieldErr().describedBy(FieldASI)... }>
							<legend class="font-medium">Ability Score Improvement or feat</legend>
							@v.fieldErr().at(FieldASI)
							<div class="flex flex-wrap items-center gap-2">
								@abilitySelect("asi1", "+1 or +2 to", v.Form.Get("asi1"))
								@abilitySelect("asi2", "and +1 to", v.Form.Get("asi2"))
								<span class="text-muted-foreground">or feat</span>
								@formSelect("", "feat", optionItems("—", v.Feats, func(o Option) string { return o.Slug }), v.Form.Get("feat"), "", "")
							</div>
							<p class="text-xs text-muted-foreground">Pick one ability for +2, two different abilities for +1 each, or a feat.</p>
							for _, f := range v.Feats {
								if groups := v.FeatChoices[f.Slug]; len(groups) > 0 {
									<div class="space-y-4 pt-2" data-show-for={ "feat=" + f.Slug } hidden?={ v.Form.Get("feat") != f.Slug }>
										for _, g := range groups {
											@choiceFieldset(g, v.Form, v.fieldErr())
										}
									</div>
								}
							}
						</fieldset>
					}
					if len(p.Features) > 0 {
						<div>
							<div class="font-medium">New features</div>
							for _, f := range p.Features {
								<details class="mt-1">
									<summary class="cursor-pointer">{ f.Name }</summary>
									<div class="mt-1 text-muted-foreground">
										@markdown(f.Description)
									</div>
								</details>
							}
						</div>
					}
					for _, g := range v.Groups {
						@choiceFieldset(g, v.Form, v.fieldErr())
					}
					@spellChecklist(v.Spells, p.Columns, v.SpellNeed, v.Form, v.fieldErr())
				</div>
			}
			@card.Footer() {
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Gain level { fmt.Sprint(p.NewLevel) }
				}
			}
		}
	</form>
}

// SubclassPicker is the subclass select (field "subclass", valued by slug, as
// two sources may name a subclass alike) with a panel per subclass that shows
// while it is picked; features gained at or below level start open.
templ SubclassPicker(subs []Option, panels []SubclassPanel, selected string, level int) {
	@formSelect("subclass", "subclass", optionItems("Decide later", subs, func(o Option) string { return o.Slug }), selected, "", "")
	for _, sp := range panels {
		<div class="mt-2 space-y-1 rounded-md border p-3 text-sm" data-show-for={ "subclass=" + sp.Slug } hidden?={ selected != sp.Slug }>
			<div class="font-medium">{ sp.Name }</div>
			if sp.Source != "" {
				<div class="text-xs text-muted-foreground">{ "Source: " + sp.Source }</div>
			}
			for _, f := range sp.Features {
				<details open?={ f.FirstLevel() > 0 && f.FirstLevel() <= level }>
					<summary class="cursor-pointer">
						{ f.Name }
						if len(f.Levels) > 0 {
							<span class="text-muted-foreground">{ " (level " + joinInts(f.Levels) + ")" }</span>
						}
					</summary>
					<div class="mt-1 text-muted-foreground">
						@markdown(f.Desc)
					</div>
				</details>
			}
		</div>
	}
}

// SubclassChange loads into the command builder dialog from the sheet's
// more menu; the owner picks another subclass for one class.
templ SubclassChange(v SubclassChangeView) {
	<form
		class="grid gap-4"
		data-subclass-form
		hx-post={ fmt.Sprintf("/characters/%d/subclass", v.CharacterID) }
		hx-on::after-request={ templ.JSUnsafeFuncCall(builderDoneJS) }
	>
		<input type="hidden" name="class" value={ v.Class }/>
		<p class="text-sm">{ "Choose another " + v.ClassName + " subclass. Its features replace those of " + v.Current + " at every level you have." }</p>
		<div>
			@SubclassPicker(v.Subclasses, v.Panels, v.CurrentSlug, v.Level)
		</div>
		<p class="text-sm text-muted-foreground">{ "Spells or options " + v.Current + " gave you stay on the sheet; remove them by hand." }</p>
		<div class="flex justify-end gap-2">
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.CloseFor(builderID)}) {
				Cancel
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Change subclass
			}
		</div>
	</form>
}

// spellChecklist picks spells to learn or prepare, under the class table's
// totals at the new level (cols) and what they leave to pick (need), with a
// refused form's picked slugs ticked and its lineage picks applied.
templ spellChecklist(spells []Option, cols map[string]string, need SpellNeed, form url.Values, fe FieldErrors) {
	if len(spells) > 0 {
		<div role="group" aria-labelledby="spell-checklist-title" { fe.describedBy(FieldSpell)... }>
			<div id="spell-checklist-title" class="font-medium">Learn or prepare spells</div>
			@fe.at(FieldSpell)
			if s := need.String(); s != "" {
				<p class="text-sm">Choose { s }.</p>
			}
			if counts := spellCounts(cols); counts != "" {
				<p class="text-xs text-muted-foreground">Class table at this level: { counts } (totals, counting spells you already have).</p>
			}
			{{ cantrips, leveled := splitCantrips(spells) }}
			{{ showC, showS := need.Cantrips >= 0 && len(cantrips) > 0, need.Spells >= 0 && len(leveled) > 0 }}
			if showC || showS {
				// app.js fills in the counts.
				<p class="text-sm" aria-live="polite">
					if showC {
						{ "Cantrips " }<span id="spell-cantrips-count">0</span>{ fmt.Sprintf(" of %d", need.Cantrips) }
					}
					if showC && showS {
						{ " · " }
					}
					if showS {
						{ "Spells " }<span id="spell-leveled-count">0</span>{ fmt.Sprintf(" of %d", need.Spells) }
					}
				</p>
			}
			<div class="mt-1 grid max-h-64 grid-cols-1 gap-1 overflow-y-auto rounded-md border p-2 sm:grid-cols-2">
				@spellBoxes("spell-cantrips", need.Cantrips, cantrips, form)
				@spellBoxes("spell-leveled", need.Spells, leveled, form)
			</div>
		</div>
	}
}

// spellBoxes ticks spells under one cap (limit; -1 for none), app.js greying
// the rest at it. contents keeps the boxes in the checklist's grid.
templ spellBoxes(id string, limit int, spells []Option, form url.Values) {
	<div
		class="contents"
		id={ id }
		if limit >= 0 {
			data-max-checked={ fmt.Sprint(limit) }
		}
	>
		for _, sp := range spells {
			// A taught spell is left unticked, not disabled: the checkbox's
			// aria-disabled would outlive app.js showing it again.
			<div data-hide-for={ taughtRules(sp.TaughtBy) } hidden?={ taughtPicked(sp.TaughtBy, form) }>
				@checkField("spell", sp.Slug, slices.Contains(form["spell"], sp.Slug) && !taughtPicked(sp.TaughtBy, form)) {
					{ sp.Name }
					<span class="text-xs text-muted-foreground">
						if sp.Level == 0 {
							cantrip
						} else {
							L{ fmt.Sprint(sp.Level) }
						}
					</span>
				}
			</div>
		}
	</div>
}

templ abilitySelect(name, label, value string) {
	<span class="text-muted-foreground">{ label }</span>
	@formSelect("", name, abilityItems, value, "", "")
}
