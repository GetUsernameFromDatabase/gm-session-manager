package views

import (
	"encoding/json"
	"fmt"
	"gm-session-manager/internal/dnd5e"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/card"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/label"
	selectcomp "gm-session-manager/internal/web/components/select"
	"gm-session-manager/internal/web/utils"
	"net/url"
	"slices"
	"strings"
)

// Option is a compendium choice in a form.
type Option struct {
	Slug  string
	Name  string
	Level int
	// TaughtBy are "<group key>=<option>" rules: a lineage picked on the same page
	// already teaches this spell, so it is not offered while one of them is picked.
	TaughtBy []string
}

// LevelUpView is the level-up helper.
type LevelUpView struct {
	CharacterID int64
	Name        string
	Level       int
	// Sheet is the character before levelling, to show what changes.
	Sheet      dnd5e.Sheet
	Classes    []Option
	Selected   string
	Plan       *dnd5e.LevelUpPlan
	Subclasses []Option
	Feats      []Option
	// FeatChoices are each feat's own choices, by slug (Grappler's ability).
	FeatChoices map[string][]ChoiceGroup
	Spells      []Option
	SpellNeed   SpellNeed
	// Groups are the class options this level adds (invocations) and the
	// feats' Spell Change.
	Groups []ChoiceGroup
	// LineageSpells are the species spells this character level teaches.
	LineageSpells []dnd5e.Spell
	Error         string
	// ErrorFor is the form field Error is about, shown there; "" at the top.
	ErrorFor string
	// Form is the refused form's values, ticked again; nil on a fresh page.
	Form url.Values
}

func (v LevelUpView) fieldErr() FieldError { return FieldError{Key: v.ErrorFor, Msg: v.Error} }

// DrawsField reports whether the page shows an error at key (see WizardView's).
func (v LevelUpView) DrawsField(key string) bool {
	if v.Plan == nil {
		return false
	}
	if key == "spell" {
		return len(v.Spells) > 0
	}
	if drawsGroup(v.Groups, key) {
		return true
	}
	if v.Plan.ASI {
		for _, f := range v.Feats {
			if drawsGroup(v.FeatChoices[f.Slug], key) {
				return true
			}
		}
	}
	return false
}

func slotSummary(slots [9]int) string {
	out := ""
	for i, n := range slots {
		if n > 0 {
			if out != "" {
				out += ", "
			}
			out += fmt.Sprintf("L%d×%d", i+1, n)
		}
	}
	if out == "" {
		return "none"
	}
	return out
}

// slotMaxima is how many slots of each level s has.
func slotMaxima(s dnd5e.Sheet) [9]int {
	var out [9]int
	for i, sl := range s.Slots {
		out[i] = sl.Max
	}
	return out
}

func sortedColumns(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	slices.Sort(keys)
	return keys
}

// spellCounts is the class table's cantrip and spell totals ("Cantrips 2 ·
// Prepared Spells 3"); slot columns are left out.
func spellCounts(cols map[string]string) string {
	var out []string
	for _, k := range sortedColumns(cols) {
		if cantrips, spells := SpellColumn(k); cantrips || spells {
			out = append(out, k+" "+cols[k])
		}
	}
	return strings.Join(out, " · ")
}

// SpellColumn tells whether a class table column is its cantrip total
// ("Cantrips Known") or its level 1+ spell total ("Prepared Spells").
func SpellColumn(name string) (cantrips, spells bool) {
	lk := strings.ToLower(name)
	cantrips = strings.Contains(lk, "cantrip")
	return cantrips, !cantrips && strings.Contains(lk, "spells")
}

// SpellNeed is how many class spells a step asks for: exactly, or at most
// when …UpTo (prepared spells). -1 is no limit (the class table has no such
// column). Book marks the spells as a spellbook's.
type SpellNeed struct {
	Cantrips, Spells         int
	CantripsUpTo, SpellsUpTo bool
	Book                     bool
}

// String is the ask ("2 cantrips and up to 1 level 1+ spell"), or "" if none.
func (n SpellNeed) String() string {
	var out []string
	if n.Cantrips > 0 {
		out = append(out, utils.IfElse(n.CantripsUpTo, "up to ", "")+Plural(n.Cantrips, "cantrip"))
	}
	if n.Spells > 0 {
		out = append(out, utils.IfElse(n.SpellsUpTo, "up to ", "")+Plural(n.Spells, "level 1+ spell")+utils.IfElse(n.Book, " for your spellbook", ""))
	}
	return strings.Join(out, " and ")
}

// Plural is "1 spell" or "2 spells".
func Plural(n int, noun string) string {
	return fmt.Sprintf("%d %s%s", n, noun, utils.IfElse(n == 1, "", "s"))
}

templ LevelUpPage(l Layout, v LevelUpView) {
	@Page(l) {
		@PageHeader("Level up "+v.Name, fmt.Sprintf("Currently level %d. Structured parts are filled in for you; you can still change anything afterwards with commands.", v.Level))
		if v.Error != "" && v.ErrorFor == "" {
			@Notice(v.Error, true, "mb-4")
		}
		<form method="get" class="mb-6 flex items-center gap-2" onchange="this.submit()">
			@label.Label(label.Props{For: "class-trigger"}) {
				Class
			}
			@formSelect("class", "class", optionItems("Choose a class…", v.Classes, func(o Option) string { return o.Slug }), v.Selected, "", "")
			<noscript>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Show
				}
			</noscript>
		</form>
		if len(v.Classes) == 0 {
			<p class="text-muted-foreground">No classes in the compendium yet. Ask the GM to import the SRD (see README), or add features by hand with commands.</p>
		}
		if v.Plan != nil {
			@levelUpForm(v, *v.Plan)
		}
	}
}

templ levelUpForm(v LevelUpView, p dnd5e.LevelUpPlan) {
	<form method="post" class="space-y-4">
		<input type="hidden" name="class" value={ p.Class.Slug }/>
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ p.Class.Name } { fmt.Sprint(p.ClassLevel) } (character level { fmt.Sprint(p.NewLevel) })
				}
			}
			@card.Content() {
				<div class="space-y-4 text-sm">
					for _, w := range p.Warnings {
						<p class="rounded-md border border-amber-500/50 bg-amber-500/10 px-3 py-2 text-amber-700 dark:text-amber-300" role="alert">{ w } You can still take the level.</p>
					}
					<div>
						<div class="font-medium">What changes</div>
						<ul class="mt-1 list-disc space-y-0.5 pl-5">
							<li>Max hit points +{ fmt.Sprint(p.AverageHP) } (fixed; or your roll below)</li>
							if pb := dnd5e.ProficiencyAt(p.NewLevel); pb != v.Sheet.ProficiencyBonus() {
								<li>Proficiency bonus { dnd5e.Signed(v.Sheet.ProficiencyBonus()) } → { dnd5e.Signed(pb) }</li>
							}
							if before := slotMaxima(v.Sheet); before != p.Slots {
								<li>Spell slots { slotSummary(before) } → { slotSummary(p.Slots) }</li>
							}
							if p.Pact != v.Sheet.Pact.Max || p.PactLevel != v.Sheet.PactLevel {
								<li>Pact slots { fmt.Sprint(p.Pact) } at level { fmt.Sprint(p.PactLevel) }</li>
							}
							for _, f := range p.Features {
								<li>
									New feature: { f.Name }
									if fx := dnd5e.ParseEffects(f.Name, f.Description, p.Class.Table, p.Class.Name).Summary(); len(fx) > 0 {
										<span class="text-muted-foreground">({ strings.Join(fx, "; ") })</span>
									}
								</li>
							}
							for _, sp := range v.LineageSpells {
								<li>{ v.Sheet.Species } spell: { sp.Name } (always prepared, once free per Long Rest)</li>
							}
							if p.ASI {
								<li>Ability Score Improvement or a feat</li>
							}
							if p.NeedsSubclass {
								<li>Choose a subclass</li>
							}
							if p.IsNewClass && v.Level > 0 {
								<li>New class: { p.Class.Name } (no new saving throw proficiencies)</li>
							}
						</ul>
					</div>
					<div>
						<div class="font-medium">Hit points</div>
						if v.Level == 0 {
							<p>First level: maximum hit die (d{ fmt.Sprint(p.Class.HitDie) }) plus Constitution: <strong>+{ fmt.Sprint(p.AverageHP) }</strong>.</p>
						} else {
							<p>Take the fixed <strong>+{ fmt.Sprint(p.AverageHP) }</strong>, or enter what you rolled on the d{ fmt.Sprint(p.Class.HitDie) } (Constitution is added for you).</p>
							@input.Input(input.Props{Name: "hp_roll", Type: "number", Class: "mt-1 w-28", Placeholder: "roll", Value: v.Form.Get("hp_roll"), Attributes: templ.Attributes{"min": "1", "max": fmt.Sprint(p.Class.HitDie)}})
						}
					</div>
					<div>
						<div class="font-medium">Spell slots after this level</div>
						<p>
							// A pure pact caster has no "none" to report.
							if p.Pact == 0 || p.Slots != ([9]int{}) {
								{ slotSummary(p.Slots) }
								if p.Pact > 0 {
									{ " · " }
								}
							}
							if p.Pact > 0 {
								Pact { fmt.Sprint(p.Pact) } at level { fmt.Sprint(p.PactLevel) }
							}
						</p>
					</div>
					if len(p.Columns) > 0 {
						<div>
							<div class="font-medium">Class table</div>
							<ul>
								for _, k := range sortedColumns(p.Columns) {
									<li>{ k }: { p.Columns[k] }</li>
								}
							</ul>
						</div>
					}
					if p.NeedsSubclass && len(v.Subclasses) > 0 {
						<div>
							@label.Label(label.Props{For: "subclass-trigger", Class: "mb-1"}) {
								Subclass
							}
							@formSelect("subclass", "subclass", optionItems("Decide later", v.Subclasses, func(o Option) string { return o.Name }), v.Form.Get("subclass"), "", "")
						</div>
					}
					if p.ASI {
						<fieldset class="space-y-2">
							<legend class="font-medium">Ability Score Improvement or feat</legend>
							<div class="flex flex-wrap items-center gap-2">
								@abilitySelect("asi1", "+1 or +2 to", v.Form.Get("asi1"))
								@abilitySelect("asi2", "and +1 to", v.Form.Get("asi2"))
								<span class="text-muted-foreground">or feat</span>
								@formSelect("", "feat", optionItems("—", v.Feats, func(o Option) string { return o.Slug }), v.Form.Get("feat"), "", "")
							</div>
							<p class="text-xs text-muted-foreground">Pick one ability for +2, two different abilities for +1 each, or a feat.</p>
							for _, f := range v.Feats {
								if groups := v.FeatChoices[f.Slug]; len(groups) > 0 {
									<div class="space-y-4 pt-2" data-show-for={ "feat=" + f.Slug } hidden?={ v.Form.Get("feat") != f.Slug }>
										for _, g := range groups {
											@choiceFieldset(g, v.Form, v.fieldErr())
										}
									</div>
								}
							}
						</fieldset>
					}
					if len(p.Features) > 0 {
						<div>
							<div class="font-medium">New features</div>
							for _, f := range p.Features {
								<details class="mt-1">
									<summary class="cursor-pointer">{ f.Name }</summary>
									<div class="mt-1 text-muted-foreground">
										@markdown(f.Description)
									</div>
								</details>
							}
						</div>
					}
					for _, g := range v.Groups {
						@choiceFieldset(g, v.Form, v.fieldErr())
					}
					@spellChecklist(v.Spells, p.Columns, v.SpellNeed, v.Form, v.fieldErr())
				</div>
			}
			@card.Footer() {
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Gain level { fmt.Sprint(p.NewLevel) }
				}
			}
		}
	</form>
}

// spellChecklist picks spells to learn or prepare, under the class table's
// totals at the new level (cols) and what they leave to pick (need), with a
// refused form's picked slugs ticked and its lineage picks applied.
templ spellChecklist(spells []Option, cols map[string]string, need SpellNeed, form url.Values, fe FieldError) {
	if len(spells) > 0 {
		<div role="group" aria-label="Learn or prepare spells" { fe.describedBy("spell")... }>
			<div class="font-medium">Learn or prepare spells</div>
			@fe.at("spell")
			if s := need.String(); s != "" {
				<p class="text-sm">Choose { s }.</p>
			}
			if counts := spellCounts(cols); counts != "" {
				<p class="text-xs text-muted-foreground">Class table at this level: { counts } (totals, counting spells you already have).</p>
			}
			<div class="mt-1 grid max-h-64 grid-cols-1 gap-1 overflow-y-auto rounded-md border p-2 sm:grid-cols-2">
				for _, sp := range spells {
					// A taught spell is left unticked, not disabled: the checkbox's
					// aria-disabled would outlive app.js showing it again.
					<div data-hide-for={ taughtRules(sp.TaughtBy) } hidden?={ taughtPicked(sp.TaughtBy, form) }>
						@checkField("spell", sp.Slug, slices.Contains(form["spell"], sp.Slug) && !taughtPicked(sp.TaughtBy, form)) {
							{ sp.Name }
							<span class="text-xs text-muted-foreground">
								if sp.Level == 0 {
									cantrip
								} else {
									L{ fmt.Sprint(sp.Level) }
								}
							</span>
						}
					</div>
				}
			</div>
		</div>
	}
}

// taughtPicked reports whether a lineage picked on the form teaches the spell
// (one of its rules is picked), so the spell is hidden and not posted.
func taughtPicked(rules []string, form url.Values) bool {
	return slices.ContainsFunc(rules, func(r string) bool {
		key, val, _ := strings.Cut(r, "=")
		return slices.Contains(form[key], val)
	})
}

// taughtRules is the rules as a JSON array for app.js (never null).
func taughtRules(rules []string) string {
	b, _ := json.Marshal(append([]string{}, rules...))
	return string(b)
}

templ abilitySelect(name, label, value string) {
	<span class="text-muted-foreground">{ label }</span>
	@formSelect("", name, abilityItems, value, "", "")
}

var abilityItems = append([]selectcomp.ItemData{{Value: "", Label: "—"}},
	selectItems(dnd5e.Abilities, func(a string) string { return a }, func(a string) string { return dnd5e.AbilityNames[a] })...)

// optionItems is a select over opts led by an empty choice labelled none.
func optionItems(none string, opts []Option, value func(Option) string) []selectcomp.ItemData {
	return append([]selectcomp.ItemData{{Value: "", Label: none}},
		selectItems(opts, value, func(o Option) string { return o.Name })...)
}
