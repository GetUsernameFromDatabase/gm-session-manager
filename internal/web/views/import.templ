package views

import (
	"fmt"
	"gm-session-manager/internal/compendium"
	"gm-session-manager/internal/db/sqlc"
	"gm-session-manager/internal/route"
	"gm-session-manager/internal/web/components/alert"
	"gm-session-manager/internal/web/components/badge"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/card"
	"gm-session-manager/internal/web/components/checkbox"
	"gm-session-manager/internal/web/components/combobox"
	"gm-session-manager/internal/web/components/icon"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/label"
	"gm-session-manager/internal/web/components/spinner"
	switchcomp "gm-session-manager/internal/web/components/switch"
	"gm-session-manager/internal/web/components/tabs"
	"gm-session-manager/internal/web/utils"
)

// FiveToolsPicker is the book list. Unchecking an imported book does
// nothing; Remove deletes it with its entries.
templ FiveToolsPicker(v FiveToolsView) {
	<form
		id={ FiveToolsID }
		method="post"
		action={ templ.SafeURL(CompendiumPath(ctx, route.CompendiumFiveTools)) }
		class="group/busy space-y-4"
		data-busy
		hx-target={ "#" + FiveToolsID }
		hx-swap="outerHTML"
	>
		if v.Msg != "" {
			@Notice(v.Msg, v.Failed, scrollBox)
		}
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			// Select-all boxes have no name, so they are not posted (app.js ticks the books).
			@label.Label(label.Props{Class: "font-normal"}) {
				@checkbox.Checkbox(checkbox.Props{Attributes: templ.Attributes{"data-check-all": ""}})
				Select all books
			}
			// The server ticks the set's books in a fresh picker, keeping the boxes ticked here.
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{
				"hx-get": CompendiumPath(ctx, route.CompendiumFiveTools) + "?" + FiveToolsSetField + "=" + FiveToolsSet2024, "hx-target": "#" + FiveToolsID, "hx-swap": "outerHTML",
				"hx-include": "#" + FiveToolsID + " [name=" + FiveToolsField + "]",
			}}) {
				Tick 2024 set
			}
		</div>
		// The list is long (hundreds of books): it scrolls inside its card.
		<div class={ "space-y-4 pr-1", scrollBox }>
			for _, g := range v.Groups {
				<section>
					<div class="mb-1 flex flex-wrap items-center justify-between gap-2">
						<h3 class="font-medium">{ g.Title }</h3>
						@label.Label(label.Props{Class: "font-normal text-muted-foreground"}) {
							@checkbox.Checkbox(checkbox.Props{Attributes: templ.Attributes{"data-check-all": "section", "aria-label": "Select all " + g.Title}})
							Select all
						}
					</div>
					<ul class="divide-y rounded-lg border">
						for _, b := range g.Books {
							<li class="relative flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-1.5">
								<div class="min-w-0 grow basis-48">
									@checkField(FiveToolsField, b.ID, b.Downloaded || b.Ticked) {
										<span class="min-w-0">{ b.Name } <code class="text-xs text-muted-foreground">{ b.ID }</code></span>
									}
								</div>
								if b.Downloaded {
									if !b.Imported.IsZero() {
										<span class="text-xs text-muted-foreground">{ "Imported " }@localTime(b.Imported)</span>
									}
									// Not removeButton: that one is 16px, too small to tap.
									@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: quietDestructive, Attributes: templ.Attributes{
										"aria-label": "Remove " + b.Name, "hx-post": route.Compendium + route.Path(route.CompendiumFiveToolsBookDelete, b.ID),
										"hx-confirm": "Remove " + b.Name + " and its entries from the compendium?",
									}}) {
										@icon.X(icon.Props{Size: 16})
									}
								}
							</li>
						}
					</ul>
				</section>
			}
		</div>
		<div class="flex flex-wrap items-center gap-3">
			@button.Button(button.Props{Type: button.TypeSubmit, Disabled: v.Running}) {
				@icon.Download()
				Import selected
			}
			if v.Running {
				<span class="text-muted-foreground">An import is running; wait for it to finish.</span>
			}
		</div>
		@busyIndicator("Starting the import…")
	</form>
}

// FiveToolsProgress is the background import: what it is downloading or
// importing while it runs, then the last one's summary. Refetched as it
// ends (reload), it also reloads the picker, whose import dates changed.
templ FiveToolsProgress(j FiveToolsJob, reload bool) {
	<div id="fivetools-progress" class="mb-3 text-sm empty:hidden" hx-swap-oob="true" { live(LiveImport, 0)... }>
		if j.Running {
			@importBar(j)
		} else if j.Msg != "" {
			@jobNotice(j)
			if reload {
				<div hidden hx-get={ CompendiumPath(ctx, route.CompendiumFiveTools) } hx-trigger="load" hx-target={ "#" + FiveToolsID } hx-swap="outerHTML"></div>
			}
		}
	</div>
}

// jobNotice is the last import's summary; its X clears it on every GM page.
templ jobNotice(j FiveToolsJob) {
	<div class="relative">
		@Notice(j.Msg, j.Failed, scrollBox+" pr-10")
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "absolute top-1.5 right-1.5", Attributes: templ.Attributes{
			"type": "button", "aria-label": "Dismiss", "hx-post": route.Compendium + route.CompendiumImportDismiss, "hx-swap": "none",
			"hx-vals": toJSON(map[string]string{DismissWasField: j.Msg}),
		}}) {
			@icon.X()
		}
	</div>
}

// importBar is the running import's label and bar.
templ importBar(j FiveToolsJob) {
	<div class="space-y-2 rounded-lg border p-3" role="status">
		<div class="flex items-center gap-2">
			@spinner.Spinner()
			<span class="min-w-0 truncate" { bind("text=imp.label")... }>{ j.label() }</span>
		</div>
		<div class="h-2 overflow-hidden rounded-full bg-muted">
			<div class="h-full bg-primary transition-[width]" style={ j.bar() } { bind("style=imp.bar")... }></div>
		</div>
		<p class="text-xs text-muted-foreground">The import goes on if you leave this page.</p>
	</div>
}

// StarterSets fills an empty compendium in one click: the 2024 SRD from
// Open5e, or the 5etools 2024 set. It shows the job's progress in place.
// card is the campaign whose Sources card holds it (0 in the empty
// compendium): the sets are then ticked for it, and that card, live itself,
// turns into the source list on success.
templ StarterSets(j FiveToolsJob, card int64) {
	{{ base := starterBase(ctx, card) }}
	<div
		id={ StarterSetsID }
		class="w-full space-y-3 text-left text-sm"
		if card == 0 {
			hx-swap-oob="true"
		}
		{ starterLive(card)... }
	>
		if j.Running {
			@importBar(j)
		} else {
			if j.Msg != "" {
				@jobNotice(j)
			}
			if j.Msg != "" && !j.Failed && card == 0 {
				@button.Button(button.Props{Href: base}) {
					Show entries
				}
			}
			<ul class="divide-y rounded-lg border">
				@starterSet("SRD 5.2 (2024)", "Free to share", "Rules, monsters, spells and items from the free 2024 SRD, via Open5e.") {
					@srdForm(base, compendium.SRD2024Key, "Import SRD", button.VariantDefault, false)
				}
				@starterSet("SRD 5.1 (2014)", "Free to share", "Rules, monsters, spells and items from the free 2014 SRD, via Open5e.") {
					@srdForm(base, compendium.SRD2014Key, "Import SRD", button.VariantOutline, false)
				}
				@starterSet("5etools 2024 books", "Private use", "The 2024 core books and every WotC supplement since.") {
					<form method="post" action={ templ.SafeURL(base + route.CompendiumFiveTools) } class="group/busy" data-busy>
						<input type="hidden" name={ FiveToolsSetField } value={ FiveToolsSet2024 }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
							@icon.Download()
							Import books
						}
						@busyIndicator("Starting the import…")
					</form>
				}
			</ul>
			<a class="inline-block text-muted-foreground underline underline-offset-4" href={ templ.SafeURL(base + "?" + TabKey + "=" + CompendiumTabImport) }>Other ways to import</a>
		}
	</div>
}

// srdForm downloads one Open5e SRD (doc) into the compendium at base;
// posted from the Data folder tab (folder), the GM comes back to it.
templ srdForm(base, doc, text string, variant button.Variant, folder bool) {
	<form method="post" action={ templ.SafeURL(base + route.CompendiumOpen5e) } class="group/busy" data-busy>
		<input type="hidden" name={ Open5eDocField } value={ doc }/>
		if folder {
			<input type="hidden" name={ ImportKey } value={ ImportTabFolder }/>
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: variant}) {
			@icon.Download()
			{ text }
		}
		@busyIndicator("Starting the import…")
	</form>
}

// starterSet is one row of StarterSets; children is its import form.
templ starterSet(title, licence, desc string) {
	<li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-2">
		<div class="min-w-0 grow basis-48">
			<div class="flex flex-wrap items-center gap-2">
				<span class="font-medium">{ title }</span>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ licence }
				}
			</div>
			<p class="text-muted-foreground">{ desc }</p>
		</div>
		{ children... }
	</li>
}

// StaleBooksBanner asks the GM to download again the 5etools books written
// by an older download (compendium.DownloadVersion), or to let the server
// do it at each start.
templ StaleBooksBanner(books []compendium.Book, auto bool) {
	@alert.Alert(alert.Props{Class: "mb-4 border-amber-500/50 bg-amber-500/10 text-amber-800 *:data-[slot=alert-description]:text-amber-800/90 dark:text-amber-300 dark:*:data-[slot=alert-description]:text-amber-300/90"}) {
		@icon.TriangleAlert()
		@alert.Title() {
			{ Plural(len(books), "5etools book") } { utils.IfElse(len(books) == 1, "needs", "need") } downloading again
		}
		@alert.Description() {
			<p>{ bookIDs(books) }: the app now prepares them differently.</p>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				<form method="post" action={ templ.SafeURL(FiveToolsPath) }>
					for _, b := range books {
						<input type="hidden" name={ FiveToolsField } value={ b.ID }/>
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						@icon.Download()
						Download again
					}
				</form>
				<form hx-post={ route.Compendium + route.CompendiumFiveToolsAuto } hx-trigger="change" hx-swap="none">
					@label.Label(label.Props{For: "fivetools-auto", Class: "font-normal"}) {
						@switchcomp.Switch(switchcomp.Props{ID: "fivetools-auto", Name: "on", Value: "true", DefaultChecked: auto, Size: switchcomp.SizeSm})
						Do this automatically from now on
					}
				</form>
			</div>
		}
	}
}

// SourcePriorityLive is the priority card of campaign's compendium (0: the
// whole one) as a live view. Live refetches swap this wrapper out of band;
// the card's own posts swap the card inside it, and "contents" keeps the
// card's sticky place in the page grid.
templ SourcePriorityLive(campaign int64, sources []sqlc.CompendiumSource, shared map[string]sqlc.CountSharedBySourceRow, counts map[string]sqlc.CountEntriesBySourceRow) {
	<div id={ SourcesID + "-live" } class="contents" hx-swap-oob="true" { live(LiveSources, campaign)... }>
		@SourcePriority(sources, shared, counts)
	</div>
}

// SourcePriority orders the sources: the first holding an entry wins its
// lookups and shows alone in lists.
templ SourcePriority(sources []sqlc.CompendiumSource, shared map[string]sqlc.CountSharedBySourceRow, counts map[string]sqlc.CountEntriesBySourceRow) {
	{{ positions := sourcePositions(sources) }}
	// md+: capped to fit from its unscrolled top (~173px) to a 1rem bottom gap,
	// so the page need not scroll; only the list scrolls (min-h-0 at every level).
	<div id={ SourcesID } class="min-w-0 md:sticky md:top-16 md:flex md:max-h-[calc(100dvh-12.5rem)] md:flex-col">
		@card.Card(card.Props{Class: "md:min-h-0 md:flex-1"}) {
			@card.Header() {
				@card.Title() {
					Source priority
				}
				@card.Description() {
					Higher wins when two sources hold the same entry. Drag or type a position.
				}
			}
			@card.Content(card.ContentProps{Class: "flex min-h-0 flex-col gap-3 md:flex-1"}) {
				// Picking a source scrolls to its row and flashes it (app.js); the list stays whole.
				<div data-source-goto>
					@combobox.Combobox(combobox.Props{Name: SourceGotoField}) {
						@combobox.Input(combobox.InputProps{ID: "source-goto", Class: "w-full", Placeholder: "Go to source…", Attributes: templ.Attributes{"aria-label": "Go to source", "autocomplete": "off"}})
						@combobox.Content() {
							@combobox.Empty() {
								No source matches.
							}
							@combobox.List() {
								for _, s := range sources {
									@combobox.Item(combobox.ItemProps{Value: s.SourceKey, Label: s.SourceKey}) {
										{ s.SourceKey }
									}
								}
							}
						}
					}
				</div>
				// app.js makes the list sortable (SortableJS) and posts the new order.
				// A live refetch keeps its scroll (live.js, data-keep-scroll).
				<ol id={ SourcesID + "-list" } data-keep-scroll class={ "divide-y rounded-lg border text-sm", scrollBox, "md:max-h-none md:min-h-0 md:flex-1" } data-sortable={ CompendiumPath(ctx, CompendiumRest(SourceOrderPath)) } data-sort-target={ "#" + SourcesID }>
					for i, s := range sources {
						// Two lines: grip, position, full key, delete (homebrew leaves that
						// cell empty); under the key, edition and count.
						<li
							class="grid grid-cols-[auto_auto_minmax(0,1fr)_auto] items-center gap-x-2 cursor-grab bg-card px-3 py-1.5 transition-colors duration-700 active:cursor-grabbing motion-reduce:transition-none data-flash:bg-accent"
							data-source-key={ s.SourceKey }
							if s.SourceKey == compendium.HomebrewSource {
								data-source-homebrew
							}
						>
							<span class="text-muted-foreground" aria-hidden="true">
								@icon.GripVertical(icon.Props{Size: 16})
							</span>
							if s.SourceKey == compendium.HomebrewSource {
								<span class="w-10 text-center text-muted-foreground tabular-nums" title="Homebrew ranks apart from the numbered sources">0</span>
							} else {
								// A quiet index that shows its box on hover or focus.
								@input.Input(input.Props{Value: fmt.Sprint(positions[i]), Class: "h-7 w-10 border-transparent bg-transparent px-1 text-center tabular-nums shadow-none hover:border-input focus-visible:border-ring dark:bg-transparent dark:hover:bg-input/30 dark:focus-visible:bg-input/30", Attributes: templ.Attributes{
									"inputmode": "numeric", "aria-label": "Position of " + s.SourceKey, "autocomplete": "off", "data-source-position": "",
								}})
							}
							// The text itself selects for copying (data-no-drag); the space after it drags.
							<span class="cursor-text truncate font-medium" title={ s.Attribution } data-no-drag>{ s.SourceKey }</span>
							<span hx-target={ "#" + SourcesID } hx-swap="outerHTML">
								if s.SourceKey != compendium.HomebrewSource {
									@sourceDeleteButton(s.SourceKey)
								}
							</span>
							{{ count := counts[s.SourceKey] }}
							{{ sh, hasShared := shared[s.SourceKey] }}
							<div class="col-start-3 min-w-0 text-xs text-muted-foreground">
								if s.Edition != "" {
									<span class="cursor-text" data-no-drag>{ s.Edition + " · " }</span>
								}
								if hasShared {
									@sourceCountLink(count, sharedHref(ctx, s.SourceKey), entryCountTitle(count, sh, true), "Browse the shared entries.")
								} else if count.Total > 0 {
									@sourceCountLink(count, sharedOnlyHref(ctx, s.SourceKey), entryCountTitle(count, sh, false), "Browse the entries only this source holds.")
								} else {
									<span class={ "tabular-nums", entryCountClass(count) } title={ entryCountTitle(count, sh, false) }>{ entryCountText(count) }</span>
								}
							</div>
						</li>
					}
				</ol>
			}
		}
	</div>
}

// sourceCountLink is a source's entry count, linking to a list of them.
templ sourceCountLink(count sqlc.CountEntriesBySourceRow, href templ.SafeURL, title, action string) {
	<a
		class={ "inline-flex items-center gap-0.5 tabular-nums hover:underline underline-offset-4", entryCountClass(count) }
		href={ href }
		title={ title }
		aria-label={ title + " " + action }
	>
		{ entryCountText(count) }
		@icon.ArrowUpRight(icon.Props{Size: 12})
	</a>
}

// sourceDeleteButton posts the key in the body, not the path (page sources
// hold "/"), to the campaign's compendium, whose overlap counts the answer
// shows.
templ sourceDeleteButton(key string) {
	@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: quietDestructive, Attributes: templ.Attributes{
		"aria-label": "Delete " + key, "title": "Delete " + key, "hx-post": CompendiumPath(ctx, route.CompendiumSourceDelete), "hx-vals": toJSON(map[string]string{SourceKeyField: key}),
		"hx-confirm": "Delete " + key + " and all its entries?",
	}}) {
		@icon.Trash2()
	}
}

// importTabs are the GM's three ways to fill the compendium: data folders on
// the host, and single pages of the compendium.Sites.
templ importTabs(n ImportNotice) {
	// Above the tabs: the job runs 5etools books and Open5e SRDs alike.
	@FiveToolsProgress(n.Job, false)
	@tabs.Tabs(tabs.Props{ID: "compendium-import", DefaultValue: utils.IfElse(n.Tab == ImportTabFolder || n.Tab == ImportTabFiveTools, n.Tab, ImportTabPage)}) {
		@tabs.List(tabs.ListProps{Class: "w-fit"}) {
			@tabs.Trigger(tabs.TriggerProps{Value: ImportTabPage}) {
				@icon.Globe()
				Web page
			}
			@tabs.Trigger(tabs.TriggerProps{Value: ImportTabFiveTools}) {
				@icon.Library()
				5etools
			}
			@tabs.Trigger(tabs.TriggerProps{Value: ImportTabFolder}) {
				@icon.FolderOpen()
				Data folder
			}
		}
		// Each panel: what it does, the action, its result, then the fine print.
		@tabs.Content(tabs.ContentProps{Value: ImportTabPage, Class: "space-y-3 text-sm"}) {
			<p class="text-muted-foreground">Import one entry from a page of the sites below: open one, find the page and paste its link.</p>
			<form method="post" action={ templ.SafeURL(CompendiumPath(ctx, route.CompendiumPagePreview)) } class="group/busy flex flex-wrap items-center gap-2" data-busy>
				<input type="hidden" name="back" value={ n.Back }/>
				// Focused when coming back from an import, ready for the next page.
				@input.Input(input.Props{Name: "page", Value: n.Page, Placeholder: "Paste a page link", Class: "max-w-md", Attributes: templ.Attributes{"required": true, "aria-label": "Page link", "autocomplete": "off", "autofocus": n.Tab == ImportTabPage}})
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Preview
				}
				@busyIndicator("Fetching…")
			</form>
			if n.Msg != "" && n.Tab == ImportTabPage {
				@Notice(n.Msg, n.Failed, scrollBox)
			}
			<ul class="list-disc space-y-1 pl-5 text-muted-foreground">
				for _, s := range compendium.Sites {
					<li>
						<a class="font-medium text-foreground underline" href={ templ.SafeURL(s.Home) } target="_blank" rel="noopener noreferrer">{ s.Host() }</a>: { s.Imports }.
						if s.Note != "" {
							<span class="text-amber-700 dark:text-amber-300">{ s.Note }</span>
							<a class="underline" href={ templ.SafeURL(s.NoteURL) } target="_blank" rel="noopener noreferrer">Browse the mirror</a>.
						}
					</li>
				}
			</ul>
			@importDetails("How it works") {
				<p>
					Other pages of these sites are tried too, as plain text whose kind you pick.
					You review and edit it before it is saved; saving the same page again replaces it.
					Entries are attributed to the book and the page they came from.
				</p>
			}
		}
		@tabs.Content(tabs.ContentProps{Value: ImportTabFiveTools, Class: "space-y-3 text-sm"}) {
			<p class="text-muted-foreground">Download whole books from the 5etools GitHub mirror. They are cached in <code>{ n.Dir }</code> and imported like any data folder.</p>
			<p class="text-xs text-muted-foreground">For private use at your own table; the books stay the property of their publishers.</p>
			if n.Msg != "" && n.Tab == ImportTabFiveTools {
				@Notice(n.Msg, n.Failed, scrollBox)
			}
			// The list comes from the network: it loads when the tab is first shown.
			<div id={ FiveToolsID } class="text-muted-foreground" hx-get={ CompendiumPath(ctx, route.CompendiumFiveTools) } hx-trigger="intersect once" hx-swap="outerHTML">Loading books…</div>
		}
		@tabs.Content(tabs.ContentProps{Value: ImportTabFolder, Class: "space-y-3 text-sm"}) {
			<p class="text-muted-foreground">Each folder in this one is a source. They are read again every time the app starts.</p>
			<div class="flex flex-wrap items-center gap-2">
				<code class="min-w-0 rounded bg-muted px-2 py-1 font-mono text-xs break-all">{ n.Dir }</code>
				@button.Button(button.Props{Size: button.SizeIconSm, Variant: button.VariantGhost, Class: "group", Attributes: templ.Attributes{"data-copy": n.Dir, "aria-label": "Copy folder path", "title": "Copy folder path"}}) {
					@icon.Copy(icon.Props{Size: 16, Class: "group-data-copied:hidden"})
					@icon.Check(icon.Props{Size: 16, Class: "hidden group-data-copied:block"})
				}
				if n.OnHost {
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": route.Compendium + route.CompendiumFolder, "hx-swap": "none"}}) {
						@icon.FolderOpen()
						Open folder
					}
				}
				<form method="post" action={ templ.SafeURL(CompendiumPath(ctx, route.CompendiumImport)) } class="group/busy" data-busy>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						@icon.Download()
						Import now
					}
					@busyIndicator("Importing…")
				</form>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				@srdForm(CompendiumPath(ctx, ""), compendium.SRD2024Key, "Download SRD 5.2 (2024)", button.VariantOutline, true)
				@srdForm(CompendiumPath(ctx, ""), compendium.SRD2014Key, "Download SRD 5.1 (2014)", button.VariantOutline, true)
			</div>
			if n.Msg != "" && n.Tab == ImportTabFolder {
				@Notice(n.Msg, n.Failed, scrollBox)
				if len(n.Off) > 0 {
					@offSources(n)
				}
			}
			@importDetails("How folders are read") {
				<ul class="list-disc space-y-1 pl-5">
					<li>A folder's name is the source's key (for example <code>srd-2024</code>; <code>homebrew</code> is reserved).</li>
					<li>
						A source folder holds the Open5e v2 JSON files of one document: <code>Document.json</code>, <code>Spell.json</code>, <code>Creature.json</code>, <code>CharacterClass.json</code>, <code>ClassFeature.json</code> and the rest, as in
						<a class="underline" href="https://github.com/open5e/open5e-api/tree/staging/data/v2/wizards-of-the-coast/srd-2024" target="_blank" rel="noopener">open5e-api data/v2</a>.
					</li>
					<li>Every entry keeps the license and attribution of its folder's <code>Document.json</code>.</li>
					<li>Folders that have not changed since the last import are skipped; entries removed from a folder are removed from the compendium.</li>
				</ul>
			}
		}
	}
}

// offSources offers the sources a folder import brought into a campaign's
// compendium that the campaign leaves off; "Use selected" ticks the chosen.
templ offSources(n ImportNotice) {
	// Through htmx, so a refusal (nothing ticked) flashes instead of a bare page.
	<form hx-post={ route.Path(route.CampaignSources, n.Campaign) } hx-swap="none" class="space-y-2 rounded-lg border p-3">
		<p>Not on in this campaign yet:</p>
		<input type="hidden" name="on" value="true"/>
		<input type="hidden" name="back" value={ SourcesBackCompendium }/>
		<ul class={ "space-y-1", scrollBox }>
			for _, k := range n.Off {
				// relative: the checkbox's absolute input stays inside the scroll box.
				<li class="relative">
					@checkField(SourceKeyField, k, true) {
						<span class="min-w-0 break-all">{ k }</span>
					}
				</li>
			}
		</ul>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
			Use selected
		}
	</form>
}

// importDetails folds an import panel's fine print away from its action.
templ importDetails(summary string) {
	<details class="text-muted-foreground">
		<summary class="cursor-pointer">{ summary }</summary>
		<div class="mt-2">
			{ children... }
		</div>
	</details>
}
