package views

import (
	"fmt"
	"gm-session-manager/internal/web/components/badge"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/empty"
	"gm-session-manager/internal/web/components/icon"
	"gm-session-manager/internal/web/components/tabs"
	"gm-session-manager/internal/web/utils"
)

templ FilesPage(l Layout, v FilesView) {
	@Page(l) {
		{{ base := FilesBase(l.CampaignID) }}
		<div class="mb-6">
			<div class="flex flex-wrap items-center gap-2">
				<h1 class="text-2xl font-semibold">Files</h1>
				@campaignSwitcher(l)
			</div>
			<p class="text-sm text-muted-foreground">Everything uploaded to notes and images, and where it is used. Removing a file from a note keeps it here until you delete it.</p>
		</div>
		if len(v.Files) == 0 {
			@filesEmpty(icon.Paperclip, utils.IfElse(l.CampaignID != 0, "No files in this campaign yet", "No files yet"), "Pictures and files added to notes and images show here.")
		} else {
			{{ idle := unusedFiles(v.Files) }}
			@tabs.Tabs(tabs.Props{ID: "files-tabs", DefaultValue: utils.IfElse(v.Tab == FilesTabUnused, FilesTabUnused, FilesTabAll), Attributes: templ.Attributes{"data-url-param": "tab"}}) {
				@tabs.List(tabs.ListProps{Class: "mb-6 w-fit"}) {
					@tabs.Trigger(tabs.TriggerProps{Value: FilesTabAll}) {
						@icon.Files()
						All
						<span class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprint(len(v.Files)) }</span>
					}
					@tabs.Trigger(tabs.TriggerProps{Value: FilesTabUnused}) {
						@icon.FileX()
						Unused
						if len(idle) > 0 {
							<span class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprint(len(idle)) }</span>
						}
					}
				}
				@tabs.Content(tabs.ContentProps{Value: FilesTabAll}) {
					@filesGrid(v.Files, base, FilesTabAll, l.CampaignID == 0)
				}
				@tabs.Content(tabs.ContentProps{Value: FilesTabUnused}) {
					if len(idle) == 0 {
						@filesEmpty(icon.CircleCheck, "Nothing to clean up", "Every file is used by a note or an image.")
					} else {
						<div class="mb-6 flex flex-wrap items-center justify-between gap-2">
							<p class="text-sm text-muted-foreground">No note or image uses these. Delete them to free { fileSize(totalSize(idle)) }.</p>
							@button.Button(button.Props{Variant: button.VariantDestructive, Size: button.SizeSm, Attributes: templ.Attributes{
								"hx-post": base + "/delete-unused", "hx-confirm": "Delete every unused file " + utils.IfElse(l.CampaignID != 0, "in this campaign ", "") + "from this computer?",
							}}) {
								@icon.Trash2()
								Delete unused
							}
						</div>
						@filesGrid(idle, base, FilesTabUnused, l.CampaignID == 0)
					}
				}
			}
		}
	}
}

templ filesEmpty(ic func(...icon.Props) templ.Component, title, description string) {
	@empty.Empty(empty.Props{Class: "border border-dashed"}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@ic()
			}
			@empty.Title() {
				{ title }
			}
			@empty.Description() {
				{ description }
			}
		}
	}
}

// filesGrid shows the files on the page at base in a grid per campaign, in
// tab (FilesTab*). One campaign's page leaves out the heading the switcher
// already names.
templ filesGrid(files []FileRow, base, tab string, headings bool) {
	for _, g := range filesByCampaign(files) {
		<section class="mb-8">
			if headings {
				<div class="mb-3 flex items-baseline gap-3 border-b pb-2">
					<h2 class="min-w-0 truncate text-lg font-semibold">{ g[0].Campaign }</h2>
					<span class="ml-auto shrink-0 text-sm text-muted-foreground tabular-nums">
						{ fmt.Sprintf("%d %s, %s", len(g), utils.IfElse(len(g) == 1, "file", "files"), fileSize(totalSize(g))) }
					</span>
				</div>
			}
			<ul class="grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-3 lg:grid-cols-4">
				for _, f := range g {
					@fileTile(f, base, tab)
				}
			</ul>
		</section>
	}
}

// fileTile shows a file as what it is: a picture on the display's black box,
// any other file as its type. An unused one can be deleted from its corner,
// which returns to tab of the page at base.
templ fileTile(f FileRow, base, tab string) {
	{{ src := fmt.Sprintf("/attachments/%d", f.ID) }}
	<li class="relative min-w-0">
		if f.Private {
			<div class="flex aspect-video items-center justify-center rounded-lg bg-muted text-muted-foreground">
				@icon.Lock(icon.Props{Size: 28})
			</div>
		} else if f.IsImage {
			<a href={ templ.SafeURL(src) } target="_blank" class="block rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50" aria-label={ "Open " + f.Name }>
				@stage("aspect-video") {
					// Pinned inside the box, as in the image library.
					<img src={ src } alt="" loading="lazy" class="absolute inset-0 size-full object-contain"/>
				}
			</a>
		} else {
			<a href={ templ.SafeURL(src) } target="_blank" class="flex aspect-video flex-col items-center justify-center gap-1 rounded-lg bg-muted text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50" aria-label={ "Open " + f.Name }>
				@icon.FileText(icon.Props{Size: 28})
				if ext := fileExt(f.Name); ext != "" {
					<span class="text-sm font-semibold">{ ext }</span>
				}
			</a>
		}
		if len(f.Uses) == 0 {
			<span class="pointer-events-none absolute top-2 left-2">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					Unused
				}
			</span>
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "absolute top-1.5 right-1.5 bg-background/85 " + quietDestructive, Attributes: templ.Attributes{
				"hx-post": fmt.Sprintf("%s/%d/delete", base, f.ID), "hx-vals": toJSON(map[string]string{"tab": tab}), "hx-confirm": "Delete this file from this computer?", "aria-label": "Delete " + utils.IfElse(f.Private, "this file", f.Name),
			}}) {
				@icon.Trash2()
			}
		}
		if f.Private {
			<p class="mt-2 truncate text-sm text-muted-foreground italic">A player's private file</p>
		} else {
			<p class="mt-2 truncate text-sm font-medium" title={ f.Name }>{ f.Name }</p>
		}
		<p class="text-xs text-muted-foreground tabular-nums">
			{ fileSize(f.Size) + ", uploaded " }
			@localTime(f.CreatedAt)
		</p>
		if len(f.Uses) == 0 {
			<p class="mt-2 text-sm text-muted-foreground">Not used anywhere</p>
		} else {
			<ul class="mt-2 grid gap-1 text-sm" aria-label="Used in">
				for _, u := range f.Uses {
					if u.Private {
						<li class="flex items-center gap-2 text-muted-foreground italic">
							<span aria-hidden="true">
								@icon.Lock(icon.Props{Size: 16})
							</span>
							A player's private block
						</li>
					} else {
						@mention(utils.IfElse(u.Kind == FileUseImage, icon.Image, icon.NotebookPen), u.URL, u.Label)
					}
				}
			</ul>
		}
	</li>
}
