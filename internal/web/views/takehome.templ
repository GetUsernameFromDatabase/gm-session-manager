package views

import (
	"gm-session-manager/internal/route"
	"gm-session-manager/internal/web/components/alert"
	"gm-session-manager/internal/web/components/badge"
	"gm-session-manager/internal/web/components/button"
	"gm-session-manager/internal/web/components/dialog"
	"gm-session-manager/internal/web/components/empty"
	"gm-session-manager/internal/web/components/field"
	"gm-session-manager/internal/web/components/icon"
	"gm-session-manager/internal/web/components/input"
	"gm-session-manager/internal/web/components/popover"
	"strconv"
	"time"
)

// localDate is a stored (UTC) time as a day and month; app.js rewrites it in
// the viewer's timezone and locale.
templ localDate(t time.Time) {
	<time datetime={ t.UTC().Format(time.RFC3339) } data-date>{ t.UTC().Format("2 Jan") }</time>
}

// takenHomeBadge marks a character whose file is out at someone's computer.
templ takenHomeBadge(t time.Time) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
		@icon.House()
		{ "Taken home " }
		@localDate(t)
	}
}

// TakeHomeDialog is the empty dialog a take-home button fills; one per page,
// outside any live region.
templ TakeHomeDialog() {
	@dialog.Dialog(dialog.Props{ID: takeHomeID}) {
		@dialog.Content(dialog.ContentProps{Class: "max-h-[90dvh] overflow-y-auto sm:max-w-lg"}) {
			<div id="take-home"></div>
		}
	}
}

// takeHomeStep is one numbered step of the dialog.
templ takeHomeStep(n, title string) {
	<li class="flex gap-3">
		<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">{ n }</span>
		<div class="min-w-0 grow space-y-2">
			<p class="font-medium">{ title }</p>
			{ children... }
		</div>
	</li>
}

// TakeHomeBody is what the dialog loads: where to get the app, and the file.
templ TakeHomeBody(v TakeHomeView) {
	@dialog.Header() {
		@dialog.Title() {
			{ "Take " + v.Name + " home" }
		}
		@dialog.Description() {
			{ "Play " + v.Name + " on your computer, then bring the changes back to the table." }
		}
	}
	<ol class="space-y-4 text-sm">
		@takeHomeStep("1", "Get the player app") {
			if len(v.Downloads) > 0 {
				<ul class="space-y-1">
					for _, name := range v.Downloads {
						<li>
							<a class="inline-flex items-center gap-2 underline-offset-2 hover:underline" href={ templ.SafeURL(route.Path(route.AppDownload, name)) }>
								@icon.Download()
								{ name }
							</a>
						</li>
					}
				</ul>
			} else {
				<p class="text-muted-foreground">{ v.noApp() }</p>
			}
		}
		@takeHomeStep("2", "Open "+v.Name+"'s file in the player app") {
			<form method="post" action={ templ.SafeURL(route.Path(route.CharacterTakeHome, v.CharacterID)) }>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					@icon.Download()
					{ "Download " + v.Name + "'s file" }
				}
			</form>
		}
	</ol>
	<p class="text-xs text-muted-foreground">
		{ v.Name + " stays playable here meanwhile." }
		if v.ByGM {
			{ " Includes " + v.Name + "'s private notes: pass the file on without opening it." }
		}
	</p>
	@dialog.Footer() {
		@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.CloseFor(takeHomeID)}) {
			Close
		}
	}
}

// HomePage lists the characters on this computer (the player app) and opens a file.
templ HomePage(l Layout, table, onlyHere []HomeCopyView, starters []HomeStarterView, handoff HandoffView) {
	@Page(l) {
		<div class="mx-auto max-w-xl">
			<div class="mb-6 flex items-start justify-between gap-3">
				<h1 class="text-2xl font-semibold">Characters on this computer</h1>
				if len(newCharacterOptions(table, starters)) > 0 {
					@button.Button(button.Props{Size: button.SizeSm, Attributes: dialog.TriggerFor(newCharacterID)}) {
						@icon.Plus()
						New character
					}
				}
			</div>
			<div id="handoff">
				@HandoffPanel(handoff)
			</div>
			if len(starters) > 0 {
				<h2 class="mb-2 text-sm font-semibold">Campaigns from your GM</h2>
				<ul class="mb-8 space-y-2">
					for _, s := range starters {
						@homeStarterRow(s)
					}
				</ul>
			}
			// While a received file waits, its panel above is the next step: "no characters" would contradict it.
			if len(table)+len(onlyHere) == 0 && handoff.State != HandoffReceived {
				@empty.Empty(empty.Props{Class: "border"}) {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.House()
						}
						@empty.Title() {
							No characters here yet
						}
						@empty.Description() {
							At the table, open your character and choose Take home in its menu. Then open the file here.
						}
					}
					@empty.Content() {
						@homeImportForm(true, false, "")
					}
				}
			} else {
				if len(table) > 0 {
					<h2 class="mb-2 text-sm font-semibold">From the table</h2>
					<ul class="space-y-2">
						for _, c := range table {
							@homeCharacterRow(c)
						}
					</ul>
				}
				if len(onlyHere) > 0 {
					<h2 class="mt-8 mb-1 text-sm font-semibold">Only on this computer</h2>
					<p class="mb-2 text-xs text-muted-foreground">Copies and new characters. They never change a table character; save one as a new character file for your GM to add.</p>
					<ul class="space-y-2">
						for _, c := range onlyHere {
							@homeCharacterRow(c)
						}
					</ul>
				}
				// Empty here only while a received file waits in its panel above.
				if len(table)+len(onlyHere) > 0 {
					<h2 class="mt-8 mb-2 text-sm font-semibold">Open another take-home or starter file</h2>
				}
				@homeImportForm(false, false, "")
			}
		</div>
		if opts := newCharacterOptions(table, starters); len(opts) > 0 {
			@newCharacterDialog(newCharacterID, opts)
		}
		for _, s := range starters {
			@newCharacterDialog(s.dialogID(), s.options())
		}
	}
}

// homeStarterRow is one campaign starter: its books, when it was saved, and
// the ways to use or remove it.
templ homeStarterRow(s HomeStarterView) {
	<li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border p-3">
		<div class="min-w-0 grow basis-48">
			<p class="truncate font-medium">{ s.Name }</p>
			if len(s.Books) == 0 {
				<p class="text-sm text-muted-foreground">No books</p>
			} else {
				// The whole list is long on a phone: the count, and the list on request.
				@popover.Popover(popover.Props{ID: s.dialogID() + "-books"}) {
					@button.Button(button.Props{Variant: button.VariantGhost, Class: "-mx-1 h-auto px-1 py-0 font-normal text-muted-foreground", Attributes: popover.Trigger(ctx)}) {
						{ Plural(len(s.Books), "book") }
						@icon.ChevronDown()
					}
					@popover.Content(popover.ContentProps{Class: "w-72 text-sm"}) {
						<ul class={ "space-y-1 pr-1", scrollBox }>
							for _, b := range s.Books {
								<li>{ b }</li>
							}
						</ul>
					}
				}
			}
			<p class="text-xs text-muted-foreground">
				{ "Saved " }
				@localTime(s.SavedAt)
			</p>
		</div>
		<div class="flex flex-wrap gap-2">
			@button.Button(button.Props{Size: button.SizeSm, Attributes: dialog.TriggerFor(s.dialogID())}) {
				@icon.Plus()
				New character…
			}
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": route.Path(route.AtHomeStarterRemove, s.CampaignID), "hx-confirm": s.removeConfirm()}}) {
				Remove
			}
		</div>
	</li>
}

// homePlayForm posts the switch to another character on this computer.
templ homePlayForm(id int64, label string, icn templ.Component) {
	<form id={ "play-" + strconv.FormatInt(id, 10) } method="post" action={ templ.SafeURL(route.Path(route.AtHomePlay, id)) }>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
			@icn
			{ label }
		}
	</form>
}

// homeCharacterRow is one character: a table character with its bring-back
// file and fallback build, or one that only exists here with its new character file.
templ homeCharacterRow(c HomeCopyView) {
	<li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border p-3">
		<div class="min-w-0 grow basis-48">
			<p class="truncate font-medium">
				if c.Current {
					<a class="underline-offset-2 hover:underline" href={ templ.SafeURL(route.Path(route.Character, c.CharacterID)) }>{ c.label() }</a>
				} else {
					<button type="submit" form={ "play-" + strconv.FormatInt(c.CharacterID, 10) } class="max-w-full cursor-pointer truncate underline-offset-2 hover:underline">{ c.label() }</button>
				}
			</p>
			if c.FromTable {
				<p class="text-sm text-muted-foreground">
					{ "Taken home " }
					@localDate(c.TakenAt)
				</p>
			}
		</div>
		if c.Current {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				Playing
			}
		} else {
			@homePlayForm(c.CharacterID, "Play", icon.Play())
		}
		@moreMenu("home-menu-"+strconv.FormatInt(c.CharacterID, 10), "More actions") {
			// Through htmx: success redirects to the copy, a refusal shows in the page's flash.
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "w-full justify-start", Attributes: templ.Attributes{"data-menu-item": "", "hx-post": route.Path(route.AtHomeMakeCopy, c.CharacterID)}}) {
				@icon.Copy()
				Make a copy
			}
		}
		<div class="flex basis-full flex-wrap gap-2">
			// Through htmx so a refusal shows here; success redirects to the download.
			<form class="group/busy" data-busy hx-post={ route.Path(route.AtHomeBringBack, c.CharacterID) }>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					@icon.Download()
					if c.FromTable {
						Save bring-back file
					} else {
						Save as new character file
					}
				}
				@busyIndicator("Saving…")
			</form>
			if c.FromTable {
				@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-post": route.Path(route.AtHomeSendPhone, c.CharacterID), "hx-target": "#handoff", "hx-swap": swapInner}}) {
					@icon.Smartphone()
					Send to phone
				}
				<p class="basis-full text-xs text-muted-foreground">This file holds your private notes. Bring it to the table yourself to keep them private.</p>
			}
		</div>
		if len(c.HomeSources) > 0 && c.Fallback == nil {
			<div class="basis-full space-y-2">
				@alert.Alert() {
					@icon.TriangleAlert()
					@alert.Description() {
						{ c.fallbackWarning() }
					}
				}
				<form hx-post={ route.Path(route.AtHomeFallback, c.CharacterID) }>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
						@icon.Shield()
						Prepare a fallback
					}
				</form>
			</div>
		}
		if c.Fallback != nil {
			<div class="ml-3 flex basis-full flex-wrap items-center justify-between gap-2 border-l-2 pl-3">
				<div class="min-w-0 grow basis-48">
					<p class="flex flex-wrap items-center gap-2 text-sm font-medium">
						<span class="truncate">{ c.Fallback.Name }</span>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							Fallback build
						}
					</p>
					<p class="text-xs text-muted-foreground">{ "Goes back inside " + c.Name + "'s file, used only if a source added here is declined." }</p>
				</div>
				if c.Fallback.Current {
					<a class="text-sm underline-offset-2 hover:underline" href={ templ.SafeURL(route.Path(route.Character, c.Fallback.CharacterID)) }>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							Editing
						}
					</a>
				} else {
					@homePlayForm(c.Fallback.CharacterID, "Edit", icon.Pencil())
				}
			</div>
		}
	</li>
}

// newCharacterDialog asks for a name and which campaign (a table character's
// or a starter) the new character starts with (hidden when there is only one).
templ newCharacterDialog(id string, options []homeNewOption) {
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					New character
				}
				@dialog.Description() {
					Starts in the wizard and stays on this computer.
				}
			}
			<form class="grid gap-4" hx-post={ route.AtHomeNew }>
				@field.Group(field.GroupProps{Class: "gap-4"}) {
					@field.Field() {
						@field.Label(field.LabelProps{For: id + "-name"}) {
							Name
						}
						@input.Input(input.Props{ID: id + "-name", Name: "name", Required: true, Attributes: templ.Attributes{"maxlength": "100", "autocomplete": "off"}})
					}
					if len(options) == 1 {
						<input type="hidden" name="from" value={ options[0].value() }/>
					} else {
						@field.Field() {
							@field.Label(field.LabelProps{For: id + "-from-trigger"}) {
								Same campaign and sources as
							}
							@formSelect(id+"-from", "from", selectItems(options, homeNewOption.value, homeNewOption.label), "", "w-full", "")
						}
					}
				}
				<div class="flex justify-end gap-2">
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.CloseFor(id)}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Create
					}
				</div>
			</form>
		}
	}
}

// homeImportForm posts a take-home zip; a copy of the same character already
// here is answered with a question in #home-import-confirm, inside the form so
// the chosen file is still there when Replace submits it. With fromPhone it
// holds a hidden handoff=1 instead of the file input, and its question goes in
// its own container (the page may hold both forms). Without fromPhone, choosing
// a file opens it at once, and Receive from phone sits beside it; centered
// when it sits in the empty state.
templ homeImportForm(centered, fromPhone bool, label string) {
	<form
		class="group/busy w-full space-y-3"
		data-busy
		hx-post={ route.AtHome }
		hx-encoding="multipart/form-data"
		hx-target={ "#" + importConfirmID(fromPhone) }
		hx-swap="innerHTML"
	>
		<div class={ "flex flex-wrap items-center gap-2", templ.KV("justify-center", centered) }>
			if fromPhone {
				<input type="hidden" name="handoff" value="1"/>
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ label }
				}
			} else {
				// A label styled as a button opens the picker: no "No file chosen" box, and the input keeps keyboard focus.
				<label class={ button.Variants(button.Props{Class: "relative cursor-pointer has-focus-visible:border-ring has-focus-visible:ring-3 has-focus-visible:ring-ring/50 group-aria-busy/busy:pointer-events-none group-aria-busy/busy:opacity-50"}) }>
					@icon.FileUp()
					Open file…
					@input.Input(input.Props{Name: "file", Type: "file", Class: "sr-only", Attributes: templ.Attributes{"accept": ".zip,application/zip", "hx-post": route.AtHome, "hx-trigger": "change"}})
				</label>
				// hx-params: inside the form, htmx would also send the chosen file; data-not-busy: no "Opening…" while it runs.
				@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-post": route.AtHomeReceive, "hx-params": "none", "hx-target": "#handoff", "hx-swap": swapInner, "data-not-busy": true}}) {
					@icon.Smartphone()
					Receive from phone
				}
			}
		</div>
		<div id={ importConfirmID(fromPhone) } data-confirm></div>
		@busyIndicator("Opening…")
	</form>
}

// HomeReplaceConfirm asks before a copy here is replaced; it holds no form,
// and Replace submits the import form around it.
templ HomeReplaceConfirm(v HomeConfirmView) {
	@alert.Alert() {
		@icon.TriangleAlert()
		@alert.Title() {
			{ v.title() }
		}
		@alert.Description() {
			{ v.message() }
		}
	}
	<div class="mt-3 flex justify-end gap-2">
		@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall("this.form.reset();this.closest('[data-confirm]').replaceChildren()")}}) {
			Cancel
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"name": "replace", "value": "1"}}) {
			{ v.buttonLabel() }
		}
	</div>
}
