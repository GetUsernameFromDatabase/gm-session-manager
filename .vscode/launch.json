{
  // The same build and data as task run and task run:player (Taskfile.yml); stop those first, they use the same ports.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MAIN",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gm-session-manager",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=nomsgpack",
      "env": { "DATA_DIR": "data/dev" }
    },
    {
      "name": "Launch player app",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gm-session-manager",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=nomsgpack",
      "args": ["--player", "--data", "data/player", "--port", "8042"]
    }
  ]
}
